[package]
name = "AlankuoRust"
version = "0.1.0"
authors = ["alankuo"]
edition = "2021"
description = "A Rust tutorials"
license = "MIT"

# See more keys and their definitions at https://doc.rust-lang.org/cargo/reference/manifest.html

[dependencies]
rand = "0.5.5"

[profile.release]
panic = 'abort'
opt-level = 3

[profile.dev]
opt-level = 3 