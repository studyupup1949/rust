[package]
name = "Assignment_Tracker_GUI"
version = "0.1.0"
edition = "2021"
description = "A simple  GUI-based Assignment Tracker built using Rust and egui for managing student assignments efficiently."
license = "MIT"
readme = "README.md"

[dependencies]
eframe = "0.27"
egui = "0.27"
chrono = "0.4"
image = "0.25"
serde = { version = "1.0", features = ["derive"] }
serde_json = "1.0"
