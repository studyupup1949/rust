[package]
name = "a"
version = "0.1.0"
edition = "2024"

# Crates.io metadata (at minimum, set `license` or `license-file` before publishing).
description = "HJ 212 ASCII protocol: framing, parsing, CRC, and builders."
readme = "README.md"
documentation = "https://docs.rs/a"

license = "Apache-2.0"

repository = "https://github.com/hklo/a"
homepage = "https://github.com/hklo/a"

keywords = ["hj212", "protocol", "crc16", "parser", "framing"]
categories = ["encoding", "parser-implementations"]

# License file is included as `LICENSE` at crate root.

# Prevent accidentally packaging large/local reference files.
# NOTE: Cargo may still include `Cargo.lock` in the package tarball automatically.
include = [
	"Cargo.toml",
	"README.md",
	"README_EN.md",
	"LICENSE",
	"src/**",
]

[dependencies]
chrono = { version = "0.4", features = ["serde"] }
thiserror = "2"
serde = { version = "1", features = ["derive"], optional = true }
sm4 = { version = "0.5", optional = true }
base64 = { version = "0.22", optional = true }

[features]
default = []
serde = ["dep:serde", "chrono/serde"]
sm4 = ["dep:sm4", "dep:base64"]
