[package]
name = "a2f-utils"
version = "0.1.0"
edition = "2021"
description = "Utility functions for A2F protocol - X25519 key exchange"
license = "Apache-2.0"
repository = "https://github.com/kcjsa/a2f-utils"

[dependencies]
x25519-dalek = "2.0"
rand = "0.8"
hkdf = "0.12"
sha2 = "0.10"
thiserror = "1.0"