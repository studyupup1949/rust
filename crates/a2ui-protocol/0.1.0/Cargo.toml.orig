[package]
name = "a2ui-protocol"
version = "0.1.0"
edition = "2021"
description = "Agent-to-UI protocol in Rust — define how AI agents communicate with user interfaces, render components, handle events"
license = "MIT OR Apache-2.0"
repository = "https://github.com/SuperInstance/a2ui-protocol"

[dependencies]
serde = { version = "1", features = ["derive"] }
bincode = "1"

[dev-dependencies]
