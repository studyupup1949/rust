[package]
name = "a3s-deep-research"
version = "0.1.4"
edition = "2021"
description = "Evidence-first, domain-agnostic deep research engine for A3S"
license = "MIT"
repository = "https://github.com/A3S-Lab/DeepResearch"
homepage = "https://github.com/A3S-Lab/DeepResearch"
keywords = ["research", "agents", "retrieval", "evidence", "a3s"]
categories = ["asynchronous", "text-processing"]

[lib]
name = "a3s_deep_research"
path = "src/lib.rs"

[dependencies]
a3s-acl = "=0.3.0"
async-trait = "0.1"
chrono = "0.4"
comrak = { version = "0.36", default-features = false }
futures = "0.3"
rand = "0.8"
regex = "1"
reqwest = { version = "0.11", default-features = false }
serde = { version = "1", features = ["derive"] }
serde_json = "1"
sha2 = "0.10"
thiserror = "2"
url = "2"
whatlang = "0.16"

[dev-dependencies]
ed25519-dalek = "2"
tempfile = "3"

[lints.rust]
unsafe_code = "forbid"
