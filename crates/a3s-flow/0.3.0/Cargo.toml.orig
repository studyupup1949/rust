[package]
name = "a3s-flow"
version = "0.3.0"
edition = "2021"
description = "A3S workflow engine — JSON DAG execution for agentic workflows (Dify/n8n style)"
license = "MIT"
repository = "https://github.com/A3S-Lab/Flow"
keywords = ["workflow", "dag", "agent", "ai", "automation"]
categories = ["asynchronous", "concurrency"]

[lib]
name = "a3s_flow"

[dependencies]
# Async runtime
tokio = { version = "1", features = ["full"] }
# Serialization (JSON DAG)
serde = { version = "1", features = ["derive"] }
serde_json = "1"
# Error handling
thiserror = "2"
# DAG / graph
petgraph = "0.6"
# Async traits
async-trait = "0.1"
# UUIDs for execution IDs
uuid = { version = "1", features = ["v4", "serde"] }
# Logging
tracing = "0.1"
# Cancellation token for graceful termination
tokio-util = "0.7"
# HTTP client (for built-in "http-request" and "mcp" nodes)
reqwest = { version = "0.12", features = ["json", "stream"] }
# Stream combinators (for SSE parsing in "mcp" node)
futures-util = "0.3"
# Byte buffers (for SSE stream handling in "mcp" node)
bytes = "1"
# Jinja2 templates (for built-in "template-transform" node)
minijinja = { version = "2", features = ["loader"] }
# Sandboxed scripting (for built-in "code" node)
rhai = { version = "1", features = ["serde"] }

[dev-dependencies]
tokio = { version = "1", features = ["full", "test-util"] }
chrono = "0.4"
