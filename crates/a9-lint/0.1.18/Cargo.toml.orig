[package]
name = "a9-lint"
version = "0.1.18"
edition = "2024"
authors = ["Chanwoo Ahn <cwahn0904@gmail.com>"]
license = "MIT"
description = "An opinionated Rust style linter configurable via Cargo.toml workspace metadata"
repository = "https://github.com/ars-vivendi/a9-lint"
keywords = ["lint", "style", "cargo", "subcommand"]
categories = ["development-tools", "development-tools::cargo-plugins"]

[[bin]]
name = "cargo-a9-lint"
path = "src/main.rs"

[dependencies]
clap = { version = "4", features = ["derive"] }
proc-macro2 = { version = "1", features = ["span-locations"] }
syn = { version = "2", features = ["full", "extra-traits", "visit", "visit-mut"] }
walkdir = "2"
toml = "0.8"
serde = { version = "1", features = ["derive"] }
serde_json = "1"
a9-prettyplease = "0.1.7"

[dev-dependencies]
tempfile = "3"

[workspace]
members = []

[workspace.lints.clippy]
all = { level = "warn", priority = -1 }
pedantic = { level = "warn", priority = -1 }
nursery = { level = "warn", priority = -1 }
option_if_let_else = "allow"
must_use_candidate = "allow"

[workspace.metadata.a9-lint]
scan = ["src"]
