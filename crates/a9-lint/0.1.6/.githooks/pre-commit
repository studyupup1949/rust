#!/usr/bin/env bash
set -euo pipefail

echo "=== pre-commit: cargo fmt ==="
cargo fmt

echo "=== pre-commit: cargo clippy --fix ==="
cargo clippy --fix --allow-dirty --allow-staged

echo "=== pre-commit: cargo test ==="
cargo test --quiet

echo "=== pre-commit: a9-lint fix ==="
cargo a9-lint fix

echo "=== pre-commit: verify fmt ==="
cargo fmt -- --check

echo "=== pre-commit: verify clippy ==="
cargo clippy -- -D warnings

echo "=== pre-commit: verify test ==="
cargo test --quiet
