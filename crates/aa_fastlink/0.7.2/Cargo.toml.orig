[package]
name = "aa_fastlink"
version = "0.7.2"
edition = "2024"
description = "Share your Anna's Archive membership, without sharing your secret key!"
readme = "README.md"
license = "MIT-0"

[[bin]]
name = "aa-fastlink"
path = "src/main.rs"

[dependencies]
clap = { version = "4.6.*", features = ["derive", "env"] }
env_logger = "0.11.*"
log = "0.4.*"
reqwest = { version = "0.13.*", features = ["blocking", "json"] }
serde = { version = "1.0.*", features = ["derive"] }
tokio = { version = "1.53.*", features = ["full"] }
warp = { version = "0.4.*", features = ["server"] }

[dev-dependencies]

[profile.dev]
opt-level = 0
debug = true
strip = false
debug-assertions = true
overflow-checks = true
lto = false
panic = 'unwind'
incremental = true
codegen-units = 256
rpath = false

[profile.release]
opt-level = 3
debug = false
strip = "symbols"
debug-assertions = false
overflow-checks = false
lto = "fat"
panic = 'unwind'
incremental = true
codegen-units = 16
rpath = false

[lints.clippy]
pedantic = { level = "deny", priority = -1 }
nursery = { level = "deny", priority = -1 }
unwrap_used = "deny"
expect_used = "deny"
indexing_slicing = "deny"
arithmetic_side_effects = "deny"
unreachable = "deny"
unimplemented = "deny"
unchecked_time_subtraction = "deny"
todo = "deny"
string_slice = "deny"
panic_in_result_fn = "deny"
panic = "deny"
exit = "deny"
as_conversions = "deny"
