[package]
name = "aabb2"
version = "0.1.6"
authors = ["nathanfaucett <nathanfaucett@gmail.com>"]

keywords = ["aabb", "2"]
description = "rust 2d axis aligned bounding box functions"
license = "MIT"
readme = "README.md"
repository = "https://gitlab.com/nathanfaucett/rs-aabb2.git"
homepage = "https://gitlab.com/nathanfaucett/rs-aabb2"

[dependencies]
number_traits = { version = "0.2" }
vec2 = { version = "0.1" }
