[package]
name = "aae-protocol"
version = "0.9.0"
edition = "2021"
rust-version = "1.75"
authors = ["Brent Ellis <brent@r3motely.net>"]
description = "Accountable Agentic Execution — protocol SDK for Rust"
license = "MIT OR Apache-2.0"
repository = "https://github.com/r3moteBee/aae"
documentation = "https://docs.rs/aae-protocol"
readme = "README.md"
keywords = ["agent", "ai", "governance", "policy", "audit"]
categories = ["api-bindings", "authentication"]

[dependencies]
serde = { version = "1", features = ["derive"] }
serde_json = "1"
serde_jcs = "0.1"
sha2 = "0.10"
chrono = { version = "0.4", features = ["serde"] }
thiserror = "1"
ulid = { version = "1", features = ["serde"] }

[dependencies.ed25519-dalek]
version = "2"
features = ["pkcs8", "pem"]
optional = true

[dependencies.base64]
version = "0.22"
optional = true

[dependencies.jsonwebtoken]
version = "9"
optional = true

[dependencies.async-trait]
version = "0.1"
optional = true

[features]
default = ["jwt", "signing"]
jwt = ["dep:jsonwebtoken"]
signing = ["dep:ed25519-dalek", "dep:base64"]
async = ["dep:async-trait"]

[dev-dependencies]
tokio = { version = "1", features = ["full"] }
hex = "0.4"

[lib]
name = "aae"
path = "src/lib.rs"
