[package]
name = "aag_cli_tools"
version = "0.1.0"
authors = ["Attanasia Garuso"]
license = "MIT OR Apache-2.0"
description = "A set of command-line tools"
readme = "README.md"
homepage = "https://Attanasia.github.io"
repository = "https://github.com/Attanasia/Attanasia.github.io"
keywords = ["cli", "tools", "rust"]
categories = ["command-line-utilities"]
[dependencies]
chrono = "0.4"         
rand = "0.8"           
meval = "0.2"          
reqwest = { version = "0.11", features = ["blocking", "json"] }
serde = { version = "1.0", features = ["derive"] }
serde_json = "1.0"


