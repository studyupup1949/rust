[package]
name = "aam-core"
version = "2.9.0"
edition.workspace = true
rust-version = "1.89.0"
license.workspace = true
repository.workspace = true
authors.workspace = true
description = "Core types and parsing engine for the AAM configuration format"
categories = ["data-structures", "parsing", "config"]
keywords = ["aam", "alias", "mapping", "config", "parser"]
readme = "../README.md"

[dependencies]
ahash = { version = "0.8.12", optional = true }
rapidhash = { version = "4.1.1", optional = true }
ripemd = { version = "0.2.0-rc.5", optional = true }
colored = "3.1.1"
rustc-hash = { version = "2.1.1" }
smol_str = "0.3.6"
bumpalo = { version = "3.20.2" }
tinyvec = { version = "1.11.0", features = ["alloc"] }
rayon = { version = "1", optional = true }
serde = { version = "1.0.228", features = ["derive"], optional = true }
pyo3 = { version = "0.29.0", features = ["extension-module", "abi3-py38"], optional = true }
jni = { version = "0.22.3", optional = true }
memmap2 = { version = "0.9.9", optional = true }
rkyv = { version = "0.8.16", features = ["std", "bytecheck"], optional = true }
toml = { version = "1.1.2", optional = true }
anyhow = "1"
nah = "0.1.2"

[features]
default = ["legacy", "aot", "release", "hash-std", "builder-extras"]
hash-std = []
hash-fx = []
hash-ahash = ["dep:ahash"]
hash-rapidhash = ["dep:rapidhash"]
hash-ripemd = ["dep:ripemd"]
perf-hash = ["hash-ahash", "dep:ahash"]
aot = ["dep:rkyv", "dep:memmap2"]
dev = []
release = []
unsafe_fast_path = []
ffi = []
python = ["pyo3"]
jni = ["dep:jni"]
legacy = []
serde = ["dep:serde"]
parallel = ["dep:rayon"]
64bit = ["rkyv/pointer_width_64"]
translator = ["dep:toml"]
splitter = []
builder-extras = []
reconstructer = []
rust-only = []

[lib]
name = "aam_core"
crate-type = ["rlib", "staticlib"]

[dev-dependencies]
serde_json = "1.0.149"
tempfile = "3.27.0"
criterion = { version = "0.8.2", features = ["html_reports"] }
