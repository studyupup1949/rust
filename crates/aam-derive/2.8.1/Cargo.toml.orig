[package]
name = "aam-derive"
version = "2.8.1"
edition.workspace = true
rust-version = "1.89.0"
license.workspace = true
repository.workspace = true
authors.workspace = true
description = "Derive macros for aam-rs: FromAam, schema_to_struct"
readme = "../README.md"
categories = ["data-structures", "parsing", "config", "development-tools"]
keywords = ["aam", "derive", "macro", "config", "parser"]

[lib]
proc-macro = true

[dependencies]
syn = { version = "2", features = ["full", "extra-traits"] }
quote = "1"
proc-macro2 = "1"
proc-macro-crate = "3"
aam-core.workspace = true
nah = "0.1.2"
