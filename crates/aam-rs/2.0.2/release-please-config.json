{
  "packages": {
    ".": {
      "release-type": "rust",
      "extra-files": [
        "Cargo.toml",
        "java/build.gradle.kts",
        "csharp/aam-csharp.csproj",
        "ruby/aam-ruby.gemspec",
        "js/package.json",
        {
          "type": "json",
          "path": "js/package.json",
          "jsonpath": "$.optionalDependencies['aam-nodejs-darwin-arm64']"
        },
        {
          "type": "json",
          "path": "js/package.json",
          "jsonpath": "$.optionalDependencies['aam-nodejs-linux-x64-gnu']"
        },
        {
          "type": "json",
          "path": "js/package.json",
          "jsonpath": "$.optionalDependencies['aam-nodejs-win32-x64-msvc']"
        },
        {
          "type": "json",
          "path": "js/package.json",
          "jsonpath": "$.optionalDependencies['aam-nodejs-darwin-x64']"
        },
        {
          "type": "toml",
          "path": "js/Cargo.toml",
          "jsonpath": "$.package.version"
        },
        {
          "type": "toml",
          "path": "ruby/ext/aam_rs/Cargo.toml",
          "jsonpath": "$.package.version"
        },
        {
          "type": "toml",
          "path": "wasm/Cargo.toml",
          "jsonpath": "$.package.version"
        },
        {
          "type": "json",
          "path": "php/composer.json",
          "jsonpath": "$.version"
        },
        "csharp/CONTRIBUTING.md",
        "README.md"
      ]
    }
  }
}