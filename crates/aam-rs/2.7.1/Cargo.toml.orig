[package]
name = "aam-rs"
version = "2.7.1"
description = "A Rust implementation of the Abstract Alias Mapping (AAM) framework for aliasing and maping aam files."
license = "MIT OR Apache-2.0"
repository = "https://gitlab.com/aam-rs/aam-rs"
edition = "2024"
rust-version = "1.89.0"
readme = "README.md"
categories = [
    "data-structures",
    "parsing",
    "config",
]
keywords = ["aam", "alias", "mapping", "config", "parser"]
authors = ["Nikita Goncharov <ininids@ininids.in.rs>"]
include = [
    "src/**/*",
    "Cargo.toml",
    "README.md",
    "LICENSE-APACHE",
    "LICENSE-MIT",
    "examples/**/*",
    "tests/**/*",
    "build.rs",
    "CHANGELOG.md",
    "PUBLIC_API.md",
    "cbindgen.toml",
]


[dependencies]
ahash = { version = "0.8.12", optional = true }
rapidhash = { version = "4.1.1", optional = true }
ripemd = { version = "0.2.0-rc.5", optional = true }
colored = "3.1.1"
rustc-hash = { version = "2.1.1" }
smol_str = "0.3.6"
bumpalo = { version = "3.20.2" }
tinyvec = { version = "1.11.0", features = ["alloc"] }
rayon = { version = "1", optional = true }
serde = { version = "1.0.228", features = ["derive"], optional = true }
pyo3 = { version = "0.29.0", features = ["extension-module", "abi3-py38"], optional = true }
jni = { version = "0.22.3", optional = true }
memmap2 = { version = "0.9.9", optional = true }
rkyv = { version = "0.8.16", features = ["std", "bytecheck"], optional = true }
toml = { version = "1.1.2", optional = true }

[build-dependencies]
csbindgen = { version = "1.9.7", optional = true }

[features]
default = ["legacy", "aot", "release", "hash-std", "builder-extras"]
hash-std = []
hash-fx = []
hash-ahash = ["dep:ahash"]
hash-rapidhash = ["dep:rapidhash"]
hash-ripemd = ["dep:ripemd"]
perf-hash = ["hash-ahash", "dep:ahash"]
aot = ["dep:rkyv", "dep:memmap2"]
dev = []
release = []
unsafe_fast_path = []
ffi = []
python = ["pyo3"]
jni = ["dep:jni"]
csharp = ["dep:csbindgen", "ffi"]
legacy = []
parallel = ["dep:rayon"]
64bit = ["rkyv/pointer_width_64"]
translator = ["dep:toml"]
splitter = []
builder-extras = []

[[example]]
name = "standard"

[[example]]
name = "standard_stress"

[[bench]]
name = "stress"
harness = false

[[example]]
name = "derive"
required-features = ["serde"]

[[example]]
name = "custom_types"

[[example]]
name = "advanced"

[[example]]
name = "schema_in_schema"

[[example]]
name = "config_inheritance"

[[example]]
name = "builder"

[[example]]
name = "translator"
required-features = ["translator"]

[dev-dependencies]
serde_json = "1.0.149"
tempfile = "3.27.0"
criterion = { version = "0.5", features = ["html_reports"] }

[lib]
name = "aam_rs"
crate-type = ["cdylib", "rlib", "staticlib"]
