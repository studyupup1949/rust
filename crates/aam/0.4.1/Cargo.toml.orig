[package]
name = "aam"
version = "0.4.1"
edition = "2024"
authors = ["INiNiDS"]
license = "GPL-3.0-or-later"
description = "AAM CLI is a CLI for AAM (learn more about AAM at https://aam.ininids.in.rs)"
readme = "README.md"
repository = "https://github.com/ininids/aam-cli"

[dependencies]
aam-rs = { version = "2.9.0", features = ["translator", "splitter", "reconstructer"] }
ratatui = "0.30.0"
crossterm = "0.29.0"
clap = { version = "4.6.0", features = ["derive"] }
tui-textarea = { package = "tui-textarea-2", version = "0.11.0", features = ["search"] }
tokio = { version = "1.51.1", features = ["full"] }
tower-lsp = "0.20.0"
anyhow = "1.0"

[package.metadata.deb]
maintainer = "INiNiDS"
section = "utils"
priority = "optional"
assets = [
    ["target/release/aam", "usr/bin/aam", "755"],
]

[package.metadata.generate-rpm]
assets = [
    { source = "target/release/aam", dest = "/usr/bin/aam", mode = "755" },
]
