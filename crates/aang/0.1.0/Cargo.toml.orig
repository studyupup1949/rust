[package]
name = "aang"
version = "0.1.0"
edition = "2021"
description = "TUI for Kora operators to monitor and reclaim rent-locked SOL on Solana"
authors = ["inspiration-gx"]
license = "MIT"
repository = "https://github.com/Shuriken-labs/Aang"
keywords = ["solana", "kora", "rent", "tui", "cli"]
categories = ["command-line-utilities", "cryptography::cryptocurrencies"]

[dependencies]
# TUI
ratatui = "0.29"
crossterm = "0.28"

# Async runtime
tokio = { version = "1.42", features = ["full"] }

# Solana
solana-sdk = "2.1"
solana-client = "2.1"
solana-account-decoder = "2.1"
spl-token = "6.0"

# CLI
clap = { version = "4.5", features = ["derive"] }

# Serialization
serde = { version = "1.0", features = ["derive"] }
serde_json = "1.0"
toml = "0.8"

# Utilities
anyhow = "1.0"
thiserror = "2.0"
chrono = { version = "0.4", features = ["serde"] }
tracing = "0.1"
tracing-subscriber = { version = "0.3", features = ["env-filter"] }
directories = "5.0"
futures = "0.3"
base64 = "0.22"
bs58 = "0.5"

# Background tasks
tokio-cron-scheduler = "0.13"

[profile.release]
lto = true
codegen-units = 1
strip = true
