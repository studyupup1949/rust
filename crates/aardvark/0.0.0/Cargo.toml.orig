[package]
name = "aardvark"
version = "0.0.0"
authors = ["Paul Lavender-Jones <paul@lavender-jones.com>"]
edition = "2018"
description = "A lightweight, performant and simple 2D game engine in Rust"
license = "MIT"
repository = "https://github.com/paullj/aardvark"
readme = "README.md"

[dependencies]
log = "0.4"
chrono = "0.4"
fern =  { version = "0.5", features = ["colored"] }