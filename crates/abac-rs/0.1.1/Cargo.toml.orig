[package]
name = "abac-rs"
version.workspace = true
authors.workspace = true
edition.workspace = true
rust-version = "1.80"
license.workspace = true
description = "Generic Attribute-Based Access Control (ABAC) evaluation engine with hbac-rs performance characteristics"
repository.workspace = true
keywords = ["abac", "access-control", "authorization", "security"]
categories = ["authentication"]

[dependencies]
acls-rs = { workspace = true, default-features = false }
fastbloom = { version = "0.14", optional = true }
smallvec = { version = "1.13", optional = true }
ipnetwork = "0.20"
serde = { version = "1.0", optional = true }
serde_json = { version = "1.0", optional = true }
thiserror = "2.0"
log = "0.4"

# For WASM: use lru without hashbrown (fallback to std HashMap, no runtime randomness)
# Also use ahash with no-rng to avoid std::time dependency
[target.'cfg(target_arch = "wasm32")'.dependencies]
lru = { version = "0.12", default-features = false }
ahash = { version = "0.8", default-features = false, features = ["no-rng", "std"] }
getrandom = { version = "0.3", features = ["wasm_js"] }

# For native: use lru with hashbrown for better performance
[target.'cfg(not(target_arch = "wasm32"))'.dependencies]
lru = "0.12"
ahash = { version = "0.8", default-features = false, features = ["compile-time-rng", "std"] }

[features]
default = ["bloom"]
bloom = ["dep:fastbloom", "dep:smallvec"]
serde = ["dep:serde", "ipnetwork/serde", "dep:serde_json", "acls-rs/serde"]

[[bench]]
name = "scaling"
harness = false

[package.metadata.docs.rs]
all-features = true
rustdoc-args = ["--cfg", "docsrs"]
