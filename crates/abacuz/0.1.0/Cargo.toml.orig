[package]
name = "abacuz"
description = "Abacuz is a command that servers an easy web access for the file system with authentication and authorization."
repository = "https://github.com/emuvi/abacuz/"
authors = ["Éverton M. Vieira"]
license = "LGPL-3.0-only"
version = "0.1.0"
edition = "2018"

[dependencies]
clap = "2"
actix-web = { version = "3", features = ["rustls"] }
rustls = "0.18"
actix-files = "0.5"
serde = { version = "1", features = ["derive"] }
serde_json = "1"
serde_derive = "1"
rand = "0.8"
base64 = "0.13"
futures = "0.3"
