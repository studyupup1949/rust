[package]
name = "abacuz"
description = "Abacuz is a command program that servers an easy web access for file storage with authentication and authorization."
repository = "https://github.com/emuvi/abacuz/"
authors = ["Éverton M. Vieira"]
license = "LGPL-3.0-only"
version = "0.1.1"
edition = "2018"

[dependencies]
clap = { version = "3", features = ["cargo"] }
qinpel-srv = "0.2.1"
