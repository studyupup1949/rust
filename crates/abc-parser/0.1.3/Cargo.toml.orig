[package]
name = "abc-parser"
version = "0.1.3"
authors = ["Askaholic"]
description = "An ABC music notation parser. Turns ABC text into Rust data structures and back."
license = "MIT"
keywords = ["abc", "music", "notation"]
categories = ["parser-implementations"]
repository = "https://gitlab.com/Askaholic/rust-abc-2"
build = "build.rs"

[build-dependencies]
peg = { version = "0.5" }

