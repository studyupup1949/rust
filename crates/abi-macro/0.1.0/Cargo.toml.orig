[package]
name = "abi-macro"
version = "0.1.0"
edition = "2024"
authors = ["ukuq"]
description = "easy abi"
repository = "https://github.com/ukuq"
license = "GPL-2.0-only"

[lib]
proc-macro = true

[dependencies]
syn = { version = "2.0", features = ["full", "extra-traits", "parsing"] }
quote = "1.0"
proc-macro2 = "1.0"