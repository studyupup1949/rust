[package]
name = "abi"
version = "0.1.0"
edition = "2024"
authors = ["ukuq"]
description = "easy abi"
repository = "https://github.com/ukuq/abi-rs"
license = "GPL-2.0-only"

[lib]

[dependencies]
abi-macro = { path = "abi-macro", version = "0.1.0" }

serde = { version = "1.0", features = ["derive"] }
serde_json = "1.0"
thiserror = "2.0"

[workspace]
members = [".", "abi-macro", "examples/abi-lib", "examples/abi-bin"]
default-members = ["."]