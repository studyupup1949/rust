[package]
# Published as ablative-frame — the bare name (and the -rs/_rs variant)
# belongs to unrelated crates on crates.io. The [lib] rename keeps
# `use frame::` for consumers, matching the liminal-rs precedent.
name = "ablative-frame"
version = "0.1.0"
description = "Frame application framework — the single dependency for Frame applications"
edition.workspace = true
rust-version.workspace = true
license.workspace = true
repository.workspace = true
authors.workspace = true

[lib]
name = "frame"

[dependencies]
frame-core = { workspace = true }
frame-state = { workspace = true }
frame-conv = { workspace = true }
frame-view = { workspace = true }
frame-mcp = { workspace = true }

[lints]
workspace = true
