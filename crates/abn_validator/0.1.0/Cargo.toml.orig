[package]
name = "abn_validator"
version = "0.1.0"
edition = "2024"
rust-version = "1.85"
readme = "README.md"
license = "MIT"
description = "Validate the format and checksum of Australian Business Numbers (ABNs)"
repository = "https://github.com/Hoody91/abn_validator"
documentation = "https://docs.rs/abn_validator"
keywords = ["abn", "validation", "checksum"]
exclude = ["/.github/**"]

[lints.rust]
unsafe_code = "forbid"

[lints.clippy]
pedantic = { level = "deny", priority = -1 }
nursery = { level = "deny", priority = -1 }
unwrap_used = "deny"

[dependencies]

[dev-dependencies]
quickcheck = "1.1.0"
