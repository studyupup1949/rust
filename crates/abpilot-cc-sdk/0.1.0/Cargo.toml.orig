[package]
name = "abpilot-cc-sdk"
version = "0.1.0"
edition = "2021"
authors = ["ABPilot Team"]
description = "Rust SDK for ABPilot CC platform"
license = "MIT OR Apache-2.0"
repository = "https://github.com/abpilot-cc/sdk"

[features]
default = ["full"]
full = ["mp", "app"]
mp = []
app = []

[dependencies]
tokio = { version = "1.35", features = ["full"] }
reqwest = { version = "0.11", features = ["json"] }
serde = { version = "1.0", features = ["derive"] }
serde_json = "1.0"
thiserror = "1.0"
hmac = "0.12"
sha2 = "0.10"
hex = "0.4"
chrono = "0.4"

[dev-dependencies]
mockito = "1.2"
tokio-test = "0.4"
