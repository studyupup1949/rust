[package]
name = "abre"
version = "0.1.5"
edition = "2021"
description = "Shorten repetitive text for display. Pipe lines in, get disambiguated lines out."
license = "MIT"
repository = "https://github.com/zcag/abre"
homepage = "https://github.com/zcag/abre"
readme = "README.md"
keywords = ["cli", "abbreviate", "shorten", "path", "text"]
categories = ["command-line-utilities", "text-processing"]

[dependencies]
clap = { version = "4", features = ["derive"] }
regex = "1"
serde_json = "1"

[dev-dependencies]
assert_cmd = "2"
predicates = "3"
