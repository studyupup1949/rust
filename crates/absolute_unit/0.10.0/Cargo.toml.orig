[package]
name = "absolute_unit"
description = "A system of scalars with units."
version = "0.10.0"
authors = ["Terrence Cole <terrence.d.cole@gmail.com>"]
edition = "2024"
readme = "README.md"
homepage = "https://github.com/terrence2/absolute_unit"
documentation = "https://github.com/terrence2/absolute_unit"
repository = "https://github.com/terrence2/absolute_unit"
license = "MIT"

[features]
default = []
nalgebra = ["dep:nalgebra"]
serde = ["dep:serde", "glam/serde", "ordered-float/serde"]

[dependencies]
anyhow = { version = "1", features = ["backtrace"] }
approx = "0.5"
glam = { version = "0.30", features = ["approx"] }
hashbag = "0.1"
nalgebra = { version = "= 0.34.1", features = ["glam030"], optional = true }
num-traits = "0.2"
ordered-float = "5.1"
serde = { version = "1.0", features = ["derive"], optional = true }

[dev-dependencies]
serde_json = { version = "1.0" }