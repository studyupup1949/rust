[package]
name = "abstract-boot"
version = "0.5.2"
description = "Abstract deployment helpers with BOOT"
repository = "https://github.com/Abstract-OS/contracts"
edition = "2021"
license = "GPL-3.0-or-later"
keywords = ["cosmos", "cosmwasm", "framework"]
authors = ["CyberHoward <cyberhoward@protonmail.com>", "Riada <riada@abstract.money>", "Abstract Money <contact@abstract.money>"]

[dependencies]
cosmwasm-std = { version = "1.1" }
cosmwasm-schema = { version = "1.1" }
cw-storage-plus = "1.0.1"
serde = { version = "1.0", default-features = false, features = ["derive"] }

semver = { package = "cw-semver", version = "1.0.0", git = "https://github.com/Abstract-OS/cw-semver.git", default-features = false }
schemars = "0.8"
cw-controllers = { version = "1.0.1" }
thiserror = { version = "1.0" }
cw2 = { version = "1.0.1" }
cw-asset = { version = "2.2" }
abstract-os = { version = "0.5.2", features = ["boot"] }

boot-core = { version = "0.5.1"  }
tokio = { version = "1.4", features = ["full"] }
log = "0.4.14"
serde_json = "1.0.79"
speculoos = "0.11.0"
