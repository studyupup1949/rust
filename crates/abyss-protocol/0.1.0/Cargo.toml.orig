[package]
name = "abyss-protocol"
version = "0.1.0"
edition = "2021"
description = "Abyss Protocol - A Cthulhu-cyberpunk CLI idle game driven by Claude Code token consumption"
license = "MIT"
authors = ["astnd"]
repository = "https://github.com/astronerd/abyss_protocol"
keywords = ["cli", "idle-game", "tui", "cthulhu", "ratatui"]
categories = ["games", "command-line-utilities"]

[dependencies]
ratatui = "0.29"
crossterm = "0.28"
tokio = { version = "1", features = ["full"] }
notify = "7"
serde = { version = "1", features = ["derive"] }
serde_json = "1"
toml = "0.8"
chrono = { version = "0.4", features = ["serde"] }
rand = "0.8"
clap = { version = "4", features = ["derive"] }
dirs = "5"
walkdir = "2"
anyhow = "1"
log = "0.4"
tachyonfx = "0.9"

[dev-dependencies]
proptest = "1.4"
