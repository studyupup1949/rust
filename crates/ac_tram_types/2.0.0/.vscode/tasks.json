{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "cargo",
			"command": "build",
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"label": "rust: cargo build"
		},
		{
			"type": "cargo",
			"command": "run",
			"group": {
				"kind": "test",
				"isDefault": true
			},
			"label": "rust: cargo run",
		},
		{
			"type": "cargo",
			"command": "fmt",
			"label": "rust: cargo fmt"
		},
		{
			"type": "cargo",
			"command": "check",
			"label": "rust: cargo check"
		},
		{
			"type": "shell",
			"command": "typeshare . --lang=typescript --output-file=./tram_types.ts && typeshare . --lang=typescript --output-file=../TRAM/frontend/src/tram_types.ts && typeshare . --lang=typescript --output-file=../TRAM_crawler/services/bluefin/src/tram_types.ts && typeshare . --lang=typescript --output-file=../emm_dashboard/src/tram_types.ts",
			"label": "generate typescript types",
			"problemMatcher": []
		}
	]
}