version = "2.0.1"
edition = "2021"
license = "MIT"

# See more keys and their definitions at https://doc.rust-lang.org/cargo/reference/manifest.html

[dependencies]
strum = "0.25"
strum_macros = "0.25"
serde = "1.0"
serde_derive = "1.0"
async_timing_util = "0.1.14"
anyhow = "1.0"
typeshare = "1.0.1"
mungos = "0.4.13"