[package]
name = "academic-journals-cli"
version.workspace = true
edition.workspace = true
description = "Command-line interface for academic journal abbreviation lookups"
license.workspace = true
repository.workspace = true
authors.workspace = true
rust-version.workspace = true
readme = "README.md"
keywords = ["journals", "abbreviations", "academic", "bibliography", "cli"]
categories = ["science", "command-line-utilities"]

[dependencies]
academic-journals = { path = "../academic-journals", version = "0.2.0", default-features = false }
clap = { version = "4.5.59", features = ["derive"] }

[lints.rust]
unsafe_code = "forbid"
missing_docs = "warn"

[lints.clippy]
all = "warn"
pedantic = "warn"
nursery = "warn"
cargo = "warn"
