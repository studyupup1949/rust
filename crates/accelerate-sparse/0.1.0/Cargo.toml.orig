[package]
name = "accelerate-sparse"
description = "Safe Rust bindings for the sparse solvers in Apple's Accelerate framework"
readme = "README.md"
version.workspace = true
edition.workspace = true
rust-version.workspace = true
license.workspace = true
repository.workspace = true
authors.workspace = true
keywords.workspace = true
categories.workspace = true
publish.workspace = true

[dependencies]
accelerate-sparse-sys = { workspace = true }

[package.metadata.docs.rs]
# See the note in the sys crate: docs.rs builds from Linux, where the macOS-only items would
# otherwise not exist to document.
targets = ["aarch64-apple-darwin"]
all-features = true
rustdoc-args = ["--cfg", "docsrs"]
