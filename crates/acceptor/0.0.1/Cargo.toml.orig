[package]
name = "acceptor"
version = "0.0.1"
edition = "2024"

authors = ["Mikou"]
license = "MIT OR Apache-2.0"
description = "no_std bundle of thin acceptors built on the accepts core traits"
readme = "README.md"

documentation = "https://docs.rs/acceptor"
repository = "https://github.com/acceptor-rs/acceptor"
homepage = "https://github.com/acceptor-rs/acceptor"

keywords = ["accepts", "acceptor", "pipeline", "async", "no-std"]
categories = ["asynchronous", "no-std"]

[dependencies]
accepts = { version = "0.0.2", default-features = false }
