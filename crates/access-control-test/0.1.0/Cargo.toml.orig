[package]
name = "access-control-test"
description = "Rust integration tests for the access control Sway test artifact."
version = "0.1.0"
edition = "2021"
authors = ["O2 Exchange <contact@o2.app>"]
license = "Apache-2.0"

[dev-dependencies]
fuels = { workspace = true }
tokio = { version = "1.12", features = ["rt", "macros"] }

[[test]]
harness = true
name = "access_control_tests"
path = "tests/harness.rs"
