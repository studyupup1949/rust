[package]
name = "access-control"
description = "An access control system for Rust, designed to be easily expandable and supporting both RBAC and ABAC at the time of writing."
license = "Apache-2.0"
version = "0.0.1"
authors = ["Julian DeMille <julian.demille@demilletech.net>", "demilleTech <company@demilletech>net"]
edition = "2018"
repository = "https://gitlab.com/demilletech/access-control.rs"
homepage = "https://gitlab.com/demilletech/access-control.rs"
documentation = "https://docs.rs/access-control"

[badges]
gitlab = { repository = "https://gitlab.com/demilletech/access-control.rs" }
is-it-maintained-issue-resolution = { repository = "https://gitlab.com/demilletech/access-control.rs" }
is-it-maintained-open-issues = { repository = "https://gitlab.com/demilletech/access-control.rs" }

[dependencies]
