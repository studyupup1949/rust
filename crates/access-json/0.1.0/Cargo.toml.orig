[package]
name = "access-json"
version = "0.1.0"
authors = ["John Foley <johnf@middlebury.edu>"]
edition = "2018"
license = "MIT OR Apache-2.0"
description = "Use serde to query large nested structures in Rust. For low-effort, read-only FFI."
repository = "https://github.com/jjfiv/access-json"
keywords = ["serde", "json", "query"]
categories = ["rust-patterns"]
readme = "README.md"

[dependencies]
serde = "1"
serde_derive = "1"
serde_json = "1"
erased-serde = "0.3"