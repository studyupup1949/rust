
[package]
authors = ['1016090998@qq.com']
edition = '2018'
name = 'accumulator-plus'
version = '1.0.1'
description = "Accumulator based on Biguint  "
license = "MIT"

[dependencies]
num-bigint = { version = "0.8.2", features = ["i128", "prime", "zeroize"], default-features = false, package = "num-bigint-dig" }
num-traits = { version= "0.2.9", default-features = false, features = ["libm"] }
num-integer = { version = "0.1.39", default-features = false }
rand_core = { version = "0.6.4", default-features = false }
rand = "0.8"
blake2-rfc =  '0.2.18'

[dev-dependencies]
criterion = "0.3"







#[features]
#default = ['std']

[[bench]]
name = "accumulator_benches"
harness = false