[package]
name = "ace-doip"
version = "0.4.0"
edition = "2024"
authors = ["Samuel Preston <samp.reston@outlook.com>"]
description = "DoIP typed message and session layer implementing ISO 13400-2."
readme = "README.md"
repository = "https://github.com/samp-reston/ace"
license = "MIT or Apache-2.0"
keywords = ["diagnostics", "vehicle", "standards"]
categories = ["development-tools", "network-programming", "automotive"]

[features]
default = ["tokio"]
serde = ["dep:serde"]
alloc = [
	"ace-core/alloc",
	"ace-proto/alloc",
	"ace-uds/alloc",
	"ace-macros/alloc",
]
std = ["alloc", "ace-core/std", "ace-proto/std"]
tokio = ["dep:tokio-util", "alloc"]

[dependencies]
ace-macros = { workspace = true }
ace-core = { workspace = true }
ace-proto = { workspace = true }
ace-uds = { workspace = true }
ace-sim = { workspace = true }

derive_more = { workspace = true, features = ["display", "from"] }
bytes = { workspace = true }
heapless = { workspace = true }
serde = { workspace = true, optional = true, features = ["derive"] }
tokio-util = { workspace = true, optional = true, features = ["codec"] }

[dev-dependencies]
proptest = { workspace = true }
ace-core = { workspace = true, features = ["std"] }
bytes = { workspace = true }
