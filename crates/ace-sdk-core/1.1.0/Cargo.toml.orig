[package]
name = "ace-sdk-core"
version = "1.1.0"
edition = "2021"
description = "ACE SDK Core - Rust client for the ACE API"
license = "MIT"
readme = "README.md"
repository = "https://github.com/ce-dot-net/ce-ace-clients"

[dependencies]
reqwest = { version = "0.12", features = ["json"] }
serde = { version = "1", features = ["derive"] }
serde_json = "1"
tokio = { version = "1", features = ["full"] }
rusqlite = { version = "0.32", features = ["bundled"] }
chrono = { version = "0.4", features = ["serde"] }
thiserror = "2"
dirs = "6"
regex = "1"
urlencoding = "2"

[dev-dependencies]
mockito = "1"
tokio-test = "0.4"
tempfile = "3"
