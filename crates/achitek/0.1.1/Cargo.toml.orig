[package]
name = "achitek"
version = "0.1.1"
edition = "2024"
rust-version = "1.90.0"
description = "achitek cli"
readme = "README.md"
repository = "https://github.com/achitek-org/achitek"
license = "MIT"
keywords = ["achitek", "blueprints", "scaffolding", "project-template"]
categories = ["command-line-utilities"]

[[bin]]
name = "achitek"
path = "src/main.rs"

[lib]
path = "src/lib.rs"

[features]
default = []
diagnostics = []
logging = []

[dependencies]
achitekfile = "0.1.0"
anyhow = "1.0.99"
clap = { version ="4.5.30", features= ["cargo", "derive"] }
colored = "3.0.0"
env_logger = "0.11.7"
git2 = "0.20.4"
lazy_static = "1.5.0"
log = "0.4.26"
miette = { version = "7.5.0", features = ["fancy"] }
regex = "1.11.1"
serde = { version ="1.0.2", features = ["derive"] }
tempfile = "3.17.1"
tera = "1.20.0"
thiserror = "2.0.11"
toml = "0.9"
walkdir = "2.5.0"
inquire = { version = "0.9", features = ["editor"] }
indexmap = { version = "2.7.1", features = ["serde"] }

[dev-dependencies]
assert_cmd = "2.0.16"
predicates = "3.1.3" # TODO: Remove?

# The profile that 'dist' will build with
[profile.dist]
inherits = "release"
lto = "thin"
