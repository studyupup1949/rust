[package]
name = "achitekfile"
description = "A tree-sitter backed semantic parser for the Achitekfile DSL"
repository = "https://github.com/achitek-org/achitekfile"
license = "MIT"
version = "0.1.0"
edition = "2024"

[dependencies]
thiserror = "2.0.18"
tree-sitter = "0.26.8"
tree-sitter-achitekfile = "0.1.0"
