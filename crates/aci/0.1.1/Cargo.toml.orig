[package]
name = "aci"
version = "0.1.1"
edition = "2024"
description = "Mount APIs as CLIs with raw HTTP and OpenAPI-backed commands"
license = "MIT"
repository = "https://github.com/f4ah6o/aci-rs"

[dependencies]
async-trait = "0.1.89"
axum = "0.8.8"
bytes = "1.10.1"
http = "1.3.1"
http-body = "1.0.1"
http-body-util = "0.1.3"
openapiv3 = "2.2.0"
reqwest = { version = "0.12.24", default-features = false, features = ["json", "rustls-tls", "http2"] }
serde = { version = "1.0.228", features = ["derive"] }
serde_json = "1.0.145"
serde_yaml = "0.9.34"
thiserror = "2.0.16"
tokio = { version = "1.47.1", features = ["macros", "rt-multi-thread", "net"] }
toml = "0.9.5"
tower = { version = "0.5.2", features = ["util"] }
url = "2.5.7"

[dev-dependencies]
tempfile = "3.23.0"
