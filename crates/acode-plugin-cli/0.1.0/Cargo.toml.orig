[package]
name = "acode-plugin-cli"
version = "0.1.0"
edition = "2024"
authors = ["Vivek <itsvks19@proton.me>"]
description = "A simple CLI tool to create Acode plugins easily"
license = "MIT"
repository = "https://github.com/itsvks19/acode-plugin-cli"
homepage = "https://github.com/itsvks19/acode-plugin-cli"
keywords = ["acode", "plugin", "cli"]
categories = ["command-line-utilities"]
readme = "README.md"

[dependencies]
clap = { version = "4.5.40", features = ["derive"] }
console = "0.16.0"
dialoguer = "0.11.0"
indicatif = "0.18.0"
reqwest = { version = "0.12.22", features = ["blocking"] }
serde = { version = "1.0.219", features = ["derive"] }
serde_json = "1.0.140"
zip = "4.2.0"
