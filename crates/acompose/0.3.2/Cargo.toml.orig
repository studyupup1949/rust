[package]
name = "acompose"
version = "0.3.2"
edition = "2024"
description = "Agent composition compositor built in Rust using the Agent Client Protocol (ACP)"
license = "MIT"
repository = "https://github.com/Amareis/acompose"
keywords = ["agent", "compositor", "acp", "mcp"]
categories = ["development-tools"]

[lib]
name = "acompose"
path = "src/lib.rs"

[[bin]]
name = "acompose"
path = "src/main.rs"

[dependencies]
agent-client-protocol = "1.0.0"
anyhow = "1.0.102"
axum = "0.8"
clap = { version = "4.6.1", features = ["derive"] }
croner = "3"
chrono = "0.4"
chrono-tz = "0.10"
rmcp = { version = "1.7", features = ["server", "macros", "schemars", "transport-streamable-http-server"] }
schemars = "1.2"
serde = { version = "1.0.228", features = ["derive"] }
serde_json = "1.0"
tokio = { version = "1.52.3", features = ["full"] }
tokio-util = { version = "0.7", features = ["compat", "rt"] }
tokio-tungstenite = "0.29"
urlencoding = "2"
uuid = { version = "1", features = ["v4"] }
futures = "0.3"
http = "1.0"
async-trait = "0.1"
path-clean = "1.0.1"
toml = "1.1.2"
tracing = "0.1.44"
tracing-subscriber = "0.3.23"
dashmap = { version = "6.2.1", features = ["serde"] }
shell-words = "1.1.1"

[dev-dependencies]
rmcp = { version = "1.7", features = ["client", "transport-async-rw"] }

[[test]]
name = "integration"
path = "tests/integration/main.rs"

[lints.clippy]
all = { level = "deny", priority = -1 }
pedantic = { level = "deny", priority = -1 }
nursery = { level = "deny", priority = -1 }
cargo = { level = "deny", priority = -1 }

unwrap_used = "deny"
expect_used = "deny"
panic = "deny"
todo = "deny"
unimplemented = "deny"
indexing_slicing = "deny"
string_slice = "deny"

too_long_first_doc_paragraph = "allow"
option_if_let_else = "allow"
module_name_repetitions = "allow"
inconsistent_digit_grouping = "allow"
missing_errors_doc = "allow"
missing_panics_doc = "allow"
multiple_crate_versions = "allow"
unused_async = "allow"
unnecessary_wraps = "allow"
unreadable_literal = "allow"
struct_field_names = "allow"
missing_const_for_fn = "allow"
doc_markdown = "allow"
unnecessary_literal_bound = "allow"
uninlined_format_args = "allow"
too_many_lines = "allow"
format_push_string = "allow"
