[package]
name = "acp-ffi"
version = "1.0.0"
edition = "2021"
description = "C FFI bindings for StateSet ACP Handler"
license = "MIT"
repository = "https://github.com/stateset/stateset-acp-handler"
documentation = "https://docs.rs/acp-ffi"
readme = "README.md"
keywords = ["acp", "commerce", "ffi", "stateset"]
categories = ["api-bindings", "development-tools::ffi"]

[lib]
name = "acp_ffi"
crate-type = ["cdylib", "staticlib"]

[dependencies]
serde = { version = "1.0", features = ["derive"] }
serde_json = "1.0"
tokio = { version = "1", features = ["rt-multi-thread", "sync"] }
uuid = { version = "1.0", features = ["v4"] }
chrono = { version = "0.4", features = ["serde"] }
once_cell = "1.19"
libc = "0.2"

[build-dependencies]
cbindgen = "0.26"

# Standalone package - not part of root workspace
[workspace]
