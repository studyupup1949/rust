[package]
name = "acp-protocol-cli"
version = "0.0.1"
edition = "2021"
authors = ["ACP Protocol Contributors"]
description = "CLI for the AI Context Protocol - index codebases for AI-assisted development"
documentation = "https://github.com/acp-protocol/acp-spec"
homepage = "https://github.com/acp-protocol/acp-spec"
repository = "https://github.com/acp-protocol/acp-spec"
readme = "README.md"
license = "MIT"
keywords = ["ai", "context", "cli", "llm", "developer-tools"]
categories = ["command-line-utilities", "development-tools"]

[[bin]]
name = "acp"
path = "src/main.rs"

[dependencies]
