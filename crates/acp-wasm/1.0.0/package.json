{
  "name": "@stateset/acp-wasm",
  "version": "1.0.0",
  "description": "WebAssembly bindings for StateSet ACP Handler",
  "main": "pkg/acp_wasm.js",
  "module": "pkg/acp_wasm.js",
  "types": "pkg/acp_wasm.d.ts",
  "files": [
    "pkg/*"
  ],
  "scripts": {
    "build": "wasm-pack build --target web --out-dir pkg",
    "build:bundler": "wasm-pack build --target bundler --out-dir pkg-bundler",
    "build:nodejs": "wasm-pack build --target nodejs --out-dir pkg-node",
    "test": "wasm-pack test --headless --chrome"
  },
  "keywords": [
    "stateset",
    "acp",
    "wasm",
    "webassembly",
    "checkout"
  ],
  "author": "StateSet",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/stateset/stateset-acp-handler"
  },
  "devDependencies": {
    "wasm-pack": "^0.12.1"
  }
}
