# UNDER CONSTRUCTION: Acropolis is not production-ready.
[package]
name = "acropolis"
version = "0.2.0"
edition = "2021"
rust-version = "1.88"
license = "MIT OR Apache-2.0"
authors = ["Trevor Knott", "Knott Dynamics"]
description = "UNDER CONSTRUCTION: A safe local-first Rust Cardano node scaffold."
documentation = "https://docs.rs/acropolis"
readme = "README.md"
keywords = ["acropolis", "cardano", "cardano-node", "blockchain", "node"]
categories = ["command-line-utilities", "network-programming"]
publish = ["crates-io"]
include = [
    "/src/**",
    "/examples/**",
    "/tests/**",
    "/docs/**",
    "/Cargo.toml",
    "/Cargo.lock",
    "/README.md",
    "/LICENSE-APACHE",
    "/LICENSE-MIT",
]

[package.metadata.acropolis]
status = "under-construction"
production-ready = false

[lib]
name = "acropolis"
path = "src/lib.rs"

[[bin]]
name = "acropolis"
path = "src/bin/acropolis.rs"

[features]
default = []
tui = ["dep:crossterm", "dep:scrin"]

[dependencies]
crossterm = { version = "0.28.1", optional = true }
scrin = { version = "0.1.82", optional = true }

[[example]]
name = "tui_dashboard"
path = "examples/tui_dashboard.rs"
required-features = ["tui"]
