[package]
name = "act-bin"
description = "File-based build system. Beta build system. Modern make. Peek three."
version = "0.0.1"
authors = ["Andrey Rublev <box@anru.me>"]
edition = "2018"

repository = "https://github.com/anru/act"
license = "Apache-2.0"

[[bin]]
name = "act"
path = "src/main.rs"

[dependencies]

act-file = { path = "../act-file", version = "0.0.1" }