[package]
name = "act_rs_smol"
version = "0.2.0"
edition = "2024"
license = "MIT OR Apache-2.0"
description = "Act.rs smol is a minimal smol oriented actor framework."
repository = "https://github.com/coruscateor/act_rs_smol"
homepage = "https://coruscateor.com/projects/act-rs-smol"
keywords = ["actor", "smol", "async", "message", "pipeline"]
categories = ["asynchronous", "concurrency"]
authors = ["Paul Saunders"]

[dependencies]

act_rs = "0.5.0"

#act_rs = { path="../act_rs" } #, features = ["async-trait"] } #Do not remove

smol = "2.0.2"

inc_dec = { version = "0.2.0", optional = true }

futures-lite = { version = "2.6.1", optional = true }

accessorise = { version = "0.2.0", optional = true }

pastey = { version = "0.2.3", optional = true }

futures = { version ="0.3.32", optional = true }

[features]
async-trait = ["act_rs/async-trait"]
thread_pool = ["inc_dec", "accessorise", "pastey"]

[package.metadata.docs.rs]
features = ["async-trait", "thread_pool", "futures"]
rustdoc-args = ["--cfg", "docsrs"]
