[package]
name = "action-proof"
version = "1.0.0"
edition = "2024"
license = "MIT OR Apache-2.0"
description = "Preflight verifier for GitHub Action manifests and release wrappers"
repository = "https://github.com/wildmason/action-proof"
homepage = "https://github.com/wildmason/action-proof"
readme = "README.md"
rust-version = "1.85"
keywords = ["github-actions", "action", "yaml", "ci", "supply-chain"]
categories = ["command-line-utilities", "development-tools"]

[dependencies]
anyhow = "1.0"
camino = { version = "1.2", features = ["serde1"] }
chrono = { version = "0.4", default-features = false, features = ["clock", "serde"] }
clap = { version = "4.5", features = ["derive"] }
dunce = "1.0"
regex = "1.11"
serde = { version = "1.0", features = ["derive"] }
serde_json = "1.0"
serde_yml = "0.0.12"
walkdir = "2.5"

[dev-dependencies]
assert_cmd = "2.0"
predicates = "3.1"
tempfile = "3.20"
