[package]
name = "actionguard"
version = "0.1.0"
edition = "2024"
description = "Policy-as-code (OPA-style, deny-overrides, fail-closed) for AI agent tool calls, in Rust"
license = "MIT"
readme = "README.md"
repository = "https://github.com/thaicn1712/actionguard"
keywords = ["llm", "agent", "policy", "security", "ai"]
categories = ["asynchronous", "development-tools"]

[lib]
path = "actionguard/policy.rs"

[dependencies]
async-trait = "0.1"
regex = "1"
serde_json = "1"

[dev-dependencies]
tokio = { version = "1", features = ["full"] }
criterion = { version = "0.8", features = ["async_tokio"] }

[[bench]]
name = "overhead"
harness = false
