[package]
name = "activecube-rs"
version = "0.0.6"
edition = "2021"
authors = ["ChainStream Team <ai@sx.ai>"]
license = "MIT"
description = "A generic GraphQL-to-SQL OLAP query engine library"
keywords = ["graphql", "sql", "olap", "query-engine", "starrocks"]
categories = ["database", "web-programming"]
repository = "https://github.com/chainstream-io/activecube-rs"

[dependencies]
async-graphql = { version = "7", features = ["dynamic-schema"] }
serde = { version = "1", features = ["derive"] }
serde_json = "1"
indexmap = { version = "2", features = ["serde"] }
tracing = "0.1"

[dev-dependencies]
pretty_assertions = "1"
tokio = { version = "1", features = ["full", "test-util"] }
