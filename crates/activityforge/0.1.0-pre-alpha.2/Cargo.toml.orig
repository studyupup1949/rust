[package]
name = "activityforge"
version = "0.1.0-pre-alpha.2"
edition = "2024"
description = "ActivityForge federated git forges over ActivityPub"
authors = ["ActivityForge Authors"]
keywords = ["activitypub", "activitystreams", "federation", "fediverse", "forgefed"]
license = "AGPL-3.0-or-later"
repository = "https://codeberg.org/activitypub-rs/activityforge"
documentation = "https://docs.rs/activityforge/"

[dependencies.activitystreams-vocabulary]
version = "0.7.0"
#path = "../activitystreams-vocabulary"
#git = "https://codeberg.org/activitypub-rs/activitystreams-vocabulary"

[dependencies.axum]
version = "0.8.8"

[dependencies.axum-server]
version = "0.8.0"
features = ["tls-rustls"]

[dependencies.http]
version = "1.4.0"

[dependencies.reqwest]
version = "0.13.1"
features = ["json", "rustls"]

[dependencies.url]
version = "2.5.8"

[dependencies.ed25519]
package = "ed25519-dalek"
version = "2.2.0"
features = ["alloc", "pkcs8"]

[dependencies.ecdsa]
version = "0.16.9"
features = ["arithmetic", "pem", "signing"]

[dependencies.sha2]
version = "0.10.9"

[dependencies.sec1]
version = "0.7.3"

[dependencies.p256]
version = "0.13.2"
features = ["arithmetic", "ecdsa"]

[dependencies.p384]
version = "0.13.1"
features = ["arithmetic", "ecdsa"]

[dependencies.rsa]
version = "0.10.0-rc.17"

[dependencies.httpsig]
version = "0.0.24"
features = ["rsa-signature"]

[dependencies.indexmap]
version = "2.9.0"

[dependencies.bytes]
version = "1.11.1"

[dependencies.base64]
package = "base64ct"
version = "1.8.3"
features = ["alloc"]

[dependencies.log]
version = "0.4"

[dependencies.env_logger]
version = "0.11.8"

[dependencies.paste]
version = "1.0.15"

[dependencies.argon2]
version = "0.5"

[dependencies.chacha20]
package = "chacha20poly1305"
version = "0.10"

[dependencies.sha3]
version = "0.10"

[dependencies.hmac]
version = "0.12.1"

[dependencies.rand]
version = "0.10.0"

[dependencies.serde]
version = "1.0.228"
features = ["derive"]

[dependencies.serde_json]
version = "1.0.149"
features = ["preserve_order"]

[dependencies.sqlx]
version = "0.8"
features = ["chrono", "json", "macros", "migrate", "postgres", "runtime-tokio", "uuid"]

[dependencies.chrono]
version = "0.4"

[dependencies.tokio]
version = "1.50"
features = ["macros", "rt-multi-thread"]

[dependencies.tower]
version = "0.5.3"

[dependencies.zeroize]
version = "1.8.2"
features = ["derive"]

[dependencies.uuid]
version = "1.22.0"

[dependencies.git]
package = "git2"
version = "0.20.4"
features = ["https", "ssh"]

[dependencies.oauth]
package = "oxide-auth"
version = "0.6.1"

[dependencies.oauth-async]
package = "oxide-auth-async"
version = "0.2.1"

[dependencies.oauth-axum]
package = "oxide-auth-axum"
version = "0.6.0"

[dependencies.async-trait]
version = "0.1.89"

[dependencies.jwt]
package = "jsonwebtoken"
version = "10.3.0"
features = ["rust_crypto"]

[features]
e2e-tests = []
ci = []
