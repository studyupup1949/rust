[package]
name = "activitylog"
version = "0.1.0"
edition = "2021"
build = "build.rs"
authors = ["Thierry Kunda"]
description = "Activity Log is a tool for registering logs of user activities on a day-to-day worklife."
license = "MIT OR Apache-2.0"
readme = "README.md"

[dependencies]
chrono = { version = "0.4.38", features = ["serde"] }
clap = { version = "4.5.20", features = ["derive"] }
csv = "1.3.1"
quick-xml = { version = "0.37.0", features = ["serialize"] }
rand = "0.8.5"
regex = "1.11.1"
serde = { version = "1.0.214", features = ["derive"] }
serde_json = "1.0.132"
toml = "0.8.19"

[build-dependencies]
regex = "1.11.1"
serde = { version = "1.0.214", features = ["derive"] }
toml = "0.8.19"
