[package]
name = "activitypub"
description = "ActivityPub in Rust"
version = "0.4.0-alpha.0"
license = "GPL-3.0"
authors = ["asonix <asonix@asonix.dog>"]
repository = "https://git.asonix.dog/Aardwolf/activitypub.git"
readme = "README.md"
keywords = ["activitystreams", "activitypub"]
edition = "2018"

[dependencies]
activitystreams = "0.4.0-alpha.0"
serde = { version = "1.0", features = ["derive"] }
serde_json = "1.0"
typetag = "0.1.4"

[dev-dependencies]
anyhow = "1.0"
