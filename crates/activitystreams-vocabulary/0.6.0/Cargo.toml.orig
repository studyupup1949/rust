[package]
name = "activitystreams-vocabulary"
version = "0.6.0"
edition = "2024"
description = "ActivityStreams 2.0 Vocabulary data structures"
authors = ["ActivityStream Vocabulary Authors"]
keywords = ["activitypub", "activitystreams", "federation", "fediverse"]
license = "AGPL-3.0-or-later"
repository = "https://codeberg.org/activitypub-rs/activitystreams-vocabulary"
documentation = "https://docs.rs/activitystreams-vocabulary/"

[dependencies.serde]
version = "1.0.228"
features = ["derive"]

[dependencies.serde_json]
version = "1.0.149"
features = ["preserve_order"]

[dependencies.xsd-types]
version = "0.9"

[dependencies.chrono]
version = "0.4"
features = ["serde"]

[dependencies.hyper]
version = "1.8"

[dependencies.langtag]
version = "1.1"

[dependencies.paste]
version = "1.0.15"

[dependencies.ammonia]
version = "4.1"

[dependencies.heck]
version = "0.5"

[dependencies.zeroize]
version = "1.8.2"
features = ["derive"]

[dependencies.base64]
package = "base64ct"
version = "1.8.3"
features = ["alloc"]

[dependencies.base58]
package = "base58ck"
version = "0.4.0"

[dependencies.pem]
package = "pem-rfc7468"
version = "1.0.0"
features = ["alloc"]


[dev-dependencies]
external-vocab = { path = "./tests/external-vocab" }
