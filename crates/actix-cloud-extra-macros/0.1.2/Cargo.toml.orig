[package]
name = "actix-cloud-extra-macros"
version = "0.1.2"
edition = "2024"
authors = ["MXWXZ <matrixwxz@gmail.com>"]
description = "Proc macros for Actix Cloud Extra."
license = "MIT"
repository = "https://github.com/MXWXZ/actix-cloud-extra"

[features]
default = ["seaorm"]
seaorm = []

[dependencies]
quote = "1.0"
syn = { version = "3.0", features = ["full", "extra-traits"] }

[lib]
proc-macro = true

[package.metadata.docs.rs]
all-features = true
rustdoc-args = ["--cfg", "docsrs"]
