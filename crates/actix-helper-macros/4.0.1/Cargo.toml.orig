[package]
name = "actix-helper-macros"
description = "Helper macros to make life easier developing actix-web applications"
repository = "https://github.com/mcronce/actix-helper-macros"
license = "MIT"
keywords = ["actix", "http", "web", "async"]
version = "4.0.1"
authors = ["Mike Cronce <mike@cronce.io>"]
edition = "2018"

[dependencies]
actix-web = {version = "4.0.0", default_features = false}
serde = "1"

actix-proc-macros = "4.0.0"

[patch.crates-io]
actix-proc-macros = {path = "actix-proc-macros"}

