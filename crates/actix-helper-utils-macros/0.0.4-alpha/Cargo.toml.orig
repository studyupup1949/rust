[package]
name = "actix-helper-utils-macros"
version = "0.0.4-alpha"
edition = "2021"
description = "Utility macros for actix web"
license = "MIT"
authors = ["tosic.killer"]
repository = "https://gitea.tosic.nu/tosic.killer/actix-utils"

[lib]
proc-macro = true

[dependencies]
syn = { version = "2.0", features = ["full", "extra-traits", "proc-macro"] }
quote = "1.0"
proc-macro2 = { version = "1.0", features = ["proc-macro"] }
proc-macro-error = "1.0"
