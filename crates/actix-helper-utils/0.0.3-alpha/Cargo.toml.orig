[workspace]
members = [
    ".",
    "actix-helper-utils-macros"
]

[package]
name = "actix-helper-utils"
version = "0.0.3-alpha"
edition = "2021"
description = "Utility macros for actix web"
license = "MIT"
authors = ["tosic.killer"]
repository = "https://gitea.tosic.nu/tosic.killer/actix-utils"

[dependencies]
actix-helper-utils-macros = { version = "0.0.4-alpha", path = "actix-helper-utils-macros" }
actix-web = "4.9.0"
validator = { version = "0.20.0", features = ["derive"] }
utoipa = { version = "5.2.0" }
