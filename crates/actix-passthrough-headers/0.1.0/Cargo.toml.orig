[package]
name = "actix-passthrough-headers"
version = "0.1.0"
rust-version = "1.94"
edition = "2024"
license = "MIT"
authors = ["ym-project <ym-project@protonmail.com>"]
description = "Passthrough headers middleware for Actix Web"
keywords = ["actix", "actix-web", "passthrough", "headers", "middleware"]
repository = "https://github.com/ym-project/actix-passthrough-headers/tree/v4"
exclude = [
	".github",
	".vscode",
	".editorconfig",
	".gitignore",
	"rust-toolchain.toml",
	"rustfmt.toml",
]

[dependencies]
actix-web = { version = "4", default-features = false }

[dev-dependencies]
actix-web = { version = "4", default-features = false, features = ["macros"] }
