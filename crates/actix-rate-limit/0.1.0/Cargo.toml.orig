[package]
name = "actix-rate-limit"
version = "0.1.0"
description = "Rate-limit middleware for actix-web"
repository = "https://github.com/arniu/kepton"
license = "MIT OR Apache-2.0"
authors = ["Arniu Tseng"]
readme = "README.md"
edition = "2018"
# publish = false

[dependencies]
actix = "0.10"
actix-web = "3"
actix-service = "1"
log = "0.4"

futures-util = "0.3"
serde = "1"
time = "0.2"

[dependencies.actix-redis]
default-features = false
version = "0.9"
