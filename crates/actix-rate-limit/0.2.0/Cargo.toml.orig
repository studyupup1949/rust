[package]
name = "actix-rate-limit"
version = "0.2.0"
description = "Rate-Limit middleware for actix-web"
repository = "https://github.com/arniu/kepton"
license = "MIT OR Apache-2.0"
authors = ["Arniu Tseng"]
readme = "README.md"
edition = "2018"
# publish = false

[dependencies]
actix-web = "3"
futures-util = "0.3"
once_cell = "1"
serde = "1"
time = "0.2"
log = "0.4"

actix = "0.10"

[dependencies.actix-redis]
default-features = false
version = "0.9"
