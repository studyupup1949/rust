[package]
name = "actix-response"
description = "Defines an ApiResponse type and re-exports a proc macro for error definitions with Actix Web."
license = "GPL-3.0-only"
version = "1.0.3"
edition = "2024"

[dependencies]
actix-response-macro = { version = "1.0.0" }
actix-web = "4.10.2"
serde = { version = "1.0.219", features = ["derive"] }
utoipa = "5"
