[package]
name = "actix-sled-session"
description = "An Actix Web Session Backend using the Sled embedded database"
version = "0.2.0"
authors = ["asonix <asonix@asonix.dog>"]
license-file = "LICENSE"
readme = "README.md"
repository = "https://git.asonix.dog/Aardwolf/actix-sled-session"
keywords = ["sled", "actix", "session", "cookie"]
edition = "2018"

# See more keys and their definitions at https://doc.rust-lang.org/cargo/reference/manifest.html

[dependencies]
actix = "0.8"
actix-session = "0.2.0"
actix-sled-cache = "0.2.0"
actix-web = "1.0"
chrono = { version = "0.4", features = ["serde"] }
failure = "0.1"
futures = "0.1"
log = "0.4"
rand = "0.7"
serde = "1.0"
serde_derive = "1.0"
serde_json = "1.0"
time = "0.1"
sled = { version = "0.29", features = ["compression"] }
sled-extensions = { version = "0.2.0", features = ["bincode"] }
uuid = { version ="0.7", features = ["serde", "v4"] }

[dev-dependencies]
actix = "0.8"
env_logger = "0.6"
