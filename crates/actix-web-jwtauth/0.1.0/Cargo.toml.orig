[package]
name = "actix-web-jwtauth"
version = "0.1.0"
description = "JWT auth for actix-web"
repository = "https://github.com/arniu/kepton"
documentation = "https://docs.rs/actix-web-jwtauth"
license = "MIT OR Apache-2.0"
edition = "2018"

exclude = [
    "key-for-test",
    "tests",
]

[features]
default = []
decode = []
encode = []

[dependencies]
actix-web = { version = "3.x", default-features = false }
futures-util = { version = "0.3", default-features = false }
serde = { version = "1.x", features = ["derive"] }
jsonwebtoken = "7.x"
openssl = "0.10"

[dev-dependencies]
actix-rt = "1.x"
actix-web = { version = "3.x", default-features = false }
anyhow = "1.x"
