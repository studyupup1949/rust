[package]
name = "actix-web-pagination"
version = "0.1.2"
description = "Pagination extractor for actix-web"
repository = "https://github.com/arniu/kepton"
documentation = "https://docs.rs/actix-web-pagination"
license = "MIT OR Apache-2.0"
edition = "2018"

[dependencies]
actix-web = { version = "3.x", default-features = false }
futures-util = { version = "0.3", default-features = false }
form_urlencoded = "1.x"

[dev-dependencies]
actix-rt = "1.x"
actix-web = { version = "3.x", default-features = false }
serde = { version = "1.x", features = ["derive"] }
