[package]
name = "actix-web-upload-example"
version = "0.0.1"
authors = ["Bevan Hunt <bevan@bevanhunt.com>"]
edition = "2018"
license = "MIT"
description = "Simple file uploader in Actix Web with Async/Await"

[dependencies]
futures = "0.3.1"
actix-multipart = "0.2.0-alpha.1"
actix-web = "2.0.0-alpha.1"
envy = "0.4.0"
concat-string = "1.0.1"
serde = "1.0.102"
