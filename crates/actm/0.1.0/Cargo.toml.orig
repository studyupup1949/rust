[package]
name = "actm"
version = "0.1.0"
authors = ["Nathan McCarty <nathan@mccarty.io>"]
edition = "2021"
description = "Tiny async actors framework for rust"
readme = "README.md"
homepage = "https://sr.ht/~thatonelutenist/actm/"
repository = "https://git.sr.ht/~thatonelutenist/actm"
license = "0BSD"

[features]
# Support for the async-std executor
async-std = ["dep:async-std"]
default = ["async-std"]

[dependencies]
async-mutex = "1.4.0"
async-std = { version = "1.12.0", optional = true }
async-trait = "0.1.58"
enum_dispatch = "0.3.8"
flume = "0.10.14"
futures = "0.3.25"
itertools = "0.10.5"
once_cell = "1.16.0"
snafu = "0.7.3"
tracing = "0.1.37"

[dev-dependencies]
async-std = { version = "1.12.0", features = ["attributes"] }
nanorand = "0.7.0"
proptest = "1.0.0"
proptest-derive = "0.3.0"
