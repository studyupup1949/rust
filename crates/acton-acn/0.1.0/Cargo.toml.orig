[package]
name = "acton-acn"
version = "0.1.0"
edition = "2021"
description = "Acton Core — кристаллический протокол связи"
license = "MIT"
repository = "https://github.com/Acton-ACN/acton_core"

[dependencies]
rand = "0.8"
rand_chacha = "0.3"
blake2 = "0.9"
serde = { version = "1.0", features = ["derive"] }
bincode = "1.3"
thiserror = "1.0"
hex = "0.4"