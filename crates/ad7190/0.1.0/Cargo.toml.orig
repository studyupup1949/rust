[package]
name = "ad7190"
version = "0.1.0"
edition = "2024"
license = "MPL-2.0"
description = "An embedded-hal-async driver for the AD7190 sigma-delta ADC"
repository = "https://github.com/dpeckett/ad7190"
keywords = ["embedded", "no-std", "adc", "ad7190", "embedded-hal"]
categories = ["embedded", "no-std"]

[dependencies]
bitflags = {version = "2.10.0", optional = true}
defmt = { version = "1.0.1", optional = true }
embedded-hal-async = "1.0.0"

[features]
default = ["dep:bitflags"]
defmt = ["dep:defmt", "embedded-hal-async/defmt-03"]
