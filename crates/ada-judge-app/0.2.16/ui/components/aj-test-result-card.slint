import { AJTheme } from "../aj-theme.slint";
import { AJContestState } from "../aj-state.slint";
import { AJTestResult, AJSubgroupVerdict } from "../models/testing.slint";
import { AJText, AJTextType } from "aj-text.slint";

export component AJTestResultCard inherits Rectangle {
    in property <int> index;

    property <AJTestResult> test-result: AJContestState.submissions[AJContestState.current-submission-index].tests-results[index];

    width: self.min-width + AJTheme.fit-space;
    height: self.min-height + AJTheme.fit-space;

    background: AJTheme.secondary-container.with-alpha(0.4);

    border-radius: AJTheme.border-radius;

    VerticalLayout {
        padding: AJTheme.padding;
        spacing: AJTheme.spacing;

        AJText {
            text: "#\{index}";
            type: AJTextType.Medium;
            color: AJTheme.container-text;
        }

        HorizontalLayout {
            AJText {
                text: "вердикт";
                horizontal-stretch: 1;
                horizontal-alignment: left;
                vertical-alignment: center;
                color: AJTheme.container-text;
            }

            AJText {
                text: {
                    if test-result.test-verdict == AJSubgroupVerdict.Ok {
                        "пройден"
                    } else if test-result.test-verdict == AJSubgroupVerdict.RuntimeError {
                        "ошибка выполнения"
                    } else if test-result.test-verdict == AJSubgroupVerdict.TimeLimitExceeded {
                        "превышено ограничение по времени"
                    } else if test-result.test-verdict == AJSubgroupVerdict.MemoryLimitExceeded {
                        "превышено ограничение по памяти"
                    } else if test-result.test-verdict == AJSubgroupVerdict.SecurityError {
                        "ошибка безопасности"
                    } else if test-result.test-verdict == AJSubgroupVerdict.WrongAnswer {
                        "неправильный ответ"
                    } else if test-result.test-verdict == AJSubgroupVerdict.PresentationError {
                        "неправильный формат вывода"
                    } else if test-result.test-verdict == AJSubgroupVerdict.Skipped {
                        "пропущен"
                    } else {
                        "тестируется"
                    }
                };
                font-italic: true;
                horizontal-stretch: 1;
                horizontal-alignment: right;
                vertical-alignment: center;
                color: AJTheme.container-text;
            }
        }

        if test-result.score != -1:
        HorizontalLayout {
            AJText {
                text: "баллы";
                horizontal-stretch: 1;
                horizontal-alignment: left;
                vertical-alignment: center;
                color: AJTheme.container-text;
            }

            AJText {
                text: test-result.score;
                font-italic: true;
                horizontal-stretch: 1;
                horizontal-alignment: right;
                vertical-alignment: center;
                color: AJTheme.container-text;
            }
        }
    }
}
