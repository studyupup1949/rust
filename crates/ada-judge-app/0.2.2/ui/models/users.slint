import { AJDateTime } from "others.slint";

export enum AJAdminLevel {
    NotAdmin,
    BetaTester,
    Admin,
    Owner
}

export struct AJAccountData {
    id: int,
    login: string,
    admin-level: AJAdminLevel,
    created-at: AJDateTime,
}

export struct AJPublicUserData {
    id: int,
    login: string,
    admin-level: AJAdminLevel,
}
