import { AJTheme } from "../aj-theme.slint";
import { AJContestState } from "../aj-state.slint";
import { AJSubgroup, AJSubgroupType } from "../models/problems.slint";
import { AJSubgroupResult, AJSubgroupVerdict } from "../models/testing.slint";
import { AJText, AJTextType } from "aj-text.slint";

export component AJSubgroupResultCard inherits Rectangle {
    in property <int> index;

    property <AJSubgroupResult> subgroup-result: AJContestState.submissions[AJContestState.current-submission-index].subgroups-results[index];
    property <AJSubgroup> subgroup: AJContestState.problems[AJContestState.current-problem-index].subgroups[index];

    width: self.min-width + AJTheme.fit-space;
    height: self.min-height + AJTheme.fit-space;

    background: AJTheme.secondary-container.with-alpha(0.4);

    border-radius: AJTheme.border-radius;

    VerticalLayout {
        padding: AJTheme.padding;
        spacing: AJTheme.spacing;

        AJText {
            text: "#\{index}";
            type: AJTextType.Medium;
            color: AJTheme.container-text;
        }

        HorizontalLayout {
            AJText {
                text: "вердикт";
                horizontal-stretch: 1;
                horizontal-alignment: left;
                vertical-alignment: center;
                color: AJTheme.container-text;
            }

            AJText {
                text: {
                    if subgroup-result.subgroup-verdict == AJSubgroupVerdict.Ok {
                        "пройдена"
                    } else if subgroup-result.subgroup-verdict == AJSubgroupVerdict.RuntimeError {
                        "ошибка выполнения"
                    } else if subgroup-result.subgroup-verdict == AJSubgroupVerdict.TimeLimitExceeded {
                        "превышено ограничение по времени"
                    } else if subgroup-result.subgroup-verdict == AJSubgroupVerdict.MemoryLimitExceeded {
                        "превышено ограничение по памяти"
                    } else if subgroup-result.subgroup-verdict == AJSubgroupVerdict.SecurityError {
                        "ошибка безопасности"
                    } else if subgroup-result.subgroup-verdict == AJSubgroupVerdict.WrongAnswer {
                        "неправильный ответ"
                    } else if subgroup-result.subgroup-verdict == AJSubgroupVerdict.PresentationError {
                        "неправильный формат вывода"
                    } else if subgroup-result.subgroup-verdict == AJSubgroupVerdict.Skipped {
                        "пропущена"
                    } else {
                        "тестируется"
                    }
                };
                font-italic: true;
                horizontal-stretch: 1;
                horizontal-alignment: right;
                vertical-alignment: center;
                color: AJTheme.container-text;
            }
        }

        HorizontalLayout {
            AJText {
                text: "тест";
                horizontal-stretch: 1;
                horizontal-alignment: left;
                vertical-alignment: center;
                color: AJTheme.container-text;
            }

            AJText {
                text: subgroup_result.test;
                font-italic: true;
                horizontal-stretch: 1;
                horizontal-alignment: right;
                vertical-alignment: center;
                color: AJTheme.container-text;
            }
        }

        if subgroup.type == AJSubgroupType.Main:
        HorizontalLayout {
            AJText {
                text: "баллы";
                horizontal-stretch: 1;
                horizontal-alignment: left;
                vertical-alignment: center;
                color: AJTheme.container-text;
            }

            AJText {
                text: subgroup-result.score;
                font-italic: true;
                horizontal-stretch: 1;
                horizontal-alignment: right;
                vertical-alignment: center;
                color: AJTheme.container-text;
            }
        }
    }
}
