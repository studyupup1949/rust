import { AJDateTime } from "others.slint";

export enum AJContestStatus {
    BeforeStart,
    Ongoing,
    Finished
}

export struct AJContest {
    id: int,
    owner-id: int,
    name: string,
    statements-url: string,
    starts-at: AJDateTime,
    ends-at: AJDateTime,
    status: AJContestStatus,
    can-manage: bool,
}

export struct AJLeaderboardRow {
    user-id: int,
    username: string,
    scores: [int],
    total-score: int,
}
