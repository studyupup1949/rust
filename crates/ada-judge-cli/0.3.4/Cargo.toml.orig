[package]
name = "ada-judge-cli"
version = "0.3.4"
description = "Cli for ada-judge"
license = "MIT"
edition = "2024"
rust-version = "1.97.0"

[dependencies]
clap = { version = "4.6.1", features = ["derive"] }
directories = "6.0.0"
serde = { version = "1.0.228", features = ["derive"] }
toml = "1.1.2"
tokio = { version = "1.52.3", features = ["rt-multi-thread", "process", "macros", "fs", "io-util"] }
chrono = "0.4.45"
anyhow = "1.0.103"
colored = "3.1.1"
zip-extensions = "0.14.1"
