[package]
name = "adamo-sys"
description = "Raw FFI bindings to the Adamo SDK. Bundles precompiled libadamo for supported targets."
version.workspace = true
edition.workspace = true
license.workspace = true
repository.workspace = true
homepage.workspace = true
# Advertise the native lib so build-scripts of dependents can discover our
# link metadata via DEP_ADAMO_* env vars.
links = "adamo"
autoexamples = false
autotests = false

# Ship the prebuilt binaries inside the crate tarball so downstream builds
# don't need network access. Keep the include list tight — the default
# cargo package would sweep in all of target/ etc.
include = [
    "src/**/*.rs",
    "build.rs",
    "prebuilt/**/*",
    "README.md",
    "LICENSE*",
]

[lib]
name = "adamo_sys"
path = "src/lib.rs"

[build-dependencies]
lzma-rs = "0.3"

[package.metadata.docs.rs]
# docs.rs builds without the prebuilt binaries on their targets; gate link-time
# code on a docsrs cfg so doc builds still succeed.
rustdoc-args = ["--cfg", "docsrs"]
