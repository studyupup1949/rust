[package]
name = "adaptive-card-core"
version.workspace = true
edition.workspace = true
rust-version.workspace = true
license.workspace = true
repository.workspace = true
homepage.workspace = true
authors.workspace = true
description = "Pure-Rust library for validating, optimizing, and transforming Microsoft Adaptive Cards v1.6"
documentation = "https://docs.rs/adaptive-card-core"
readme = "README.md"
keywords = ["adaptive-cards", "validation", "accessibility", "json-schema", "microsoft"]
categories = ["data-structures", "encoding", "parser-implementations"]

[lib]
path = "src/lib.rs"

[dependencies]
serde.workspace = true
serde_json.workspace = true
thiserror.workspace = true
once_cell.workspace = true
jsonschema = { version = "0.46", default-features = false }

[dev-dependencies]
pretty_assertions = "1"
insta = { version = "1", features = ["json", "yaml"] }
cargo-husky = { version = "1", default-features = false, features = ["user-hooks"] }

[lints.rust]
unsafe_code = "forbid"

[lints.clippy]
all = { level = "deny", priority = -1 }
pedantic = { level = "warn", priority = -1 }
module_name_repetitions = "allow"
missing_errors_doc = "allow"
missing_panics_doc = "allow"
