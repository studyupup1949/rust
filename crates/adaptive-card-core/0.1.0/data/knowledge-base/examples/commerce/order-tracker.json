{
  "id": "commerce/order-tracker",
  "title": "Order Tracker \u2014 Track Shipments, Returns, and Order History",
  "description": "E-commerce order management card with order tracking (status timeline, carrier info), shipment details with delivery progress, return/exchange request form, and recent orders list. Uses ToggleVisibility for section navigation, FactSet for shipment details, Container styles for delivery status progression.",
  "category": "commerce",
  "tags": [
    "order",
    "tracker",
    "shipping",
    "delivery",
    "ecommerce",
    "return",
    "exchange",
    "toggle-visibility",
    "status"
  ],
  "use_cases": [
    "Track package delivery status and carrier info",
    "Request return or exchange for an order",
    "View recent order history with status",
    "E-commerce customer service portal"
  ],
  "host_targets": [
    "generic",
    "teams",
    "web_chat"
  ],
  "complexity": "advanced",
  "card": {
    "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
    "type": "AdaptiveCard",
    "version": "1.5",
    "metadata": {
      "webUrl": "https://greentic.io/cards/order-tracker",
      "demo_mode": true
    },
    "body": [
      {
        "type": "Container",
        "id": "orderMenu",
        "isVisible": true,
        "style": "emphasis",
        "bleed": true,
        "items": [
          {
            "type": "ColumnSet",
            "columns": [
              {
                "type": "Column",
                "width": "auto",
                "items": [
                  {
                    "type": "Image",
                    "url": "https://img.icons8.com/fluency/96/package.png",
                    "size": "Medium"
                  }
                ],
                "verticalContentAlignment": "Center"
              },
              {
                "type": "Column",
                "width": "stretch",
                "items": [
                  {
                    "type": "TextBlock",
                    "text": "Order Tracker",
                    "size": "ExtraLarge",
                    "weight": "Bolder",
                    "color": "Accent"
                  },
                  {
                    "type": "TextBlock",
                    "text": "Track shipments, manage returns, and contact support.",
                    "spacing": "None",
                    "isSubtle": true,
                    "wrap": true
                  }
                ]
              }
            ]
          },
          {
            "type": "ActionSet",
            "spacing": "Medium",
            "actions": [
              {
                "type": "Action.ToggleVisibility",
                "title": "\ud83d\udce6 Track an Order",
                "style": "positive",
                "targetElements": [
                  {
                    "elementId": "orderMenu",
                    "isVisible": false
                  },
                  {
                    "elementId": "trackOrder",
                    "isVisible": true
                  }
                ]
              },
              {
                "type": "Action.ToggleVisibility",
                "title": "\u21a9\ufe0f Return / Exchange",
                "targetElements": [
                  {
                    "elementId": "orderMenu",
                    "isVisible": false
                  },
                  {
                    "elementId": "returnOrder",
                    "isVisible": true
                  }
                ]
              },
              {
                "type": "Action.ToggleVisibility",
                "title": "\ud83d\udccb Order History",
                "targetElements": [
                  {
                    "elementId": "orderMenu",
                    "isVisible": false
                  },
                  {
                    "elementId": "orderHistory",
                    "isVisible": true
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "Container",
        "id": "trackOrder",
        "isVisible": false,
        "items": [
          {
            "type": "TextBlock",
            "text": "\ud83d\udce6 Track Your Order",
            "size": "Large",
            "weight": "Bolder",
            "color": "Accent"
          },
          {
            "type": "Input.Text",
            "id": "tracking_number",
            "label": "Order ID or Tracking Number",
            "placeholder": "e.g. ORD-2026-04-0892",
            "isRequired": true
          },
          {
            "type": "ActionSet",
            "actions": [
              {
                "type": "Action.ToggleVisibility",
                "title": "\ud83d\udd0d Track",
                "style": "positive",
                "targetElements": [
                  {
                    "elementId": "trackOrder",
                    "isVisible": false
                  },
                  {
                    "elementId": "trackResult",
                    "isVisible": true
                  }
                ]
              },
              {
                "type": "Action.ToggleVisibility",
                "title": "\u2190 Back",
                "targetElements": [
                  {
                    "elementId": "trackOrder",
                    "isVisible": false
                  },
                  {
                    "elementId": "orderMenu",
                    "isVisible": true
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "Container",
        "id": "trackResult",
        "isVisible": false,
        "items": [
          {
            "type": "TextBlock",
            "text": "\ud83d\udce6 Shipment Status",
            "size": "Large",
            "weight": "Bolder",
            "color": "Accent"
          },
          {
            "type": "Container",
            "style": "emphasis",
            "items": [
              {
                "type": "TextBlock",
                "text": "Order ORD-2026-04-0892",
                "weight": "Bolder"
              },
              {
                "type": "FactSet",
                "facts": [
                  {
                    "title": "Item",
                    "value": "USB-C Docking Station (Dell WD19S)"
                  },
                  {
                    "title": "Qty",
                    "value": "1"
                  },
                  {
                    "title": "Ordered",
                    "value": "April 8, 2026"
                  },
                  {
                    "title": "Carrier",
                    "value": "JNE Express \u2014 REG"
                  },
                  {
                    "title": "Tracking",
                    "value": "JNE-0124-8827-4410"
                  },
                  {
                    "title": "Est. Delivery",
                    "value": "April 14-15, 2026"
                  }
                ]
              }
            ]
          },
          {
            "type": "TextBlock",
            "text": "Tracking Timeline",
            "weight": "Bolder",
            "spacing": "Medium"
          },
          {
            "type": "FactSet",
            "facts": [
              {
                "title": "Apr 8, 14:22",
                "value": "\ud83d\udccb Order confirmed"
              },
              {
                "title": "Apr 9, 09:10",
                "value": "\ud83d\udce6 Packed & shipped from Jakarta"
              },
              {
                "title": "Apr 10, 06:45",
                "value": "\ud83d\ude9a In transit \u2014 Jakarta Hub \u2192 Lampung"
              },
              {
                "title": "Apr 11, 18:30",
                "value": "\ud83c\udfed Arrived at Lampung sorting facility"
              },
              {
                "title": "Apr 12, 08:00",
                "value": "\ud83d\udef5 Out for delivery"
              }
            ]
          },
          {
            "type": "Container",
            "style": "good",
            "spacing": "Medium",
            "items": [
              {
                "type": "TextBlock",
                "text": "\ud83d\udef5 Out for Delivery \u2014 Expected today!",
                "weight": "Bolder",
                "color": "Good"
              }
            ]
          },
          {
            "type": "ActionSet",
            "spacing": "Medium",
            "actions": [
              {
                "type": "Action.Submit",
                "title": "\ud83d\udcde Contact Driver",
                "data": {
                  "action": "contact_driver",
                  "order_id": "ORD-2026-04-0892",
                  "demo_mode": true
                }
              },
              {
                "type": "Action.Submit",
                "title": "\u26a0\ufe0f Report Issue",
                "style": "destructive",
                "data": {
                  "action": "report_delivery_issue",
                  "order_id": "ORD-2026-04-0892",
                  "demo_mode": true
                }
              },
              {
                "type": "Action.ToggleVisibility",
                "title": "\u2190 Back",
                "targetElements": [
                  {
                    "elementId": "trackResult",
                    "isVisible": false
                  },
                  {
                    "elementId": "orderMenu",
                    "isVisible": true
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "Container",
        "id": "returnOrder",
        "isVisible": false,
        "items": [
          {
            "type": "TextBlock",
            "text": "\u21a9\ufe0f Return or Exchange",
            "size": "Large",
            "weight": "Bolder",
            "color": "Accent"
          },
          {
            "type": "Input.Text",
            "id": "return_order_id",
            "label": "Order ID",
            "placeholder": "e.g. ORD-2026-04-0892",
            "isRequired": true
          },
          {
            "type": "Input.ChoiceSet",
            "id": "return_reason",
            "label": "Reason",
            "isRequired": true,
            "choices": [
              {
                "title": "\ud83d\udce6 Wrong item received",
                "value": "wrong_item"
              },
              {
                "title": "\ud83d\udc94 Item damaged / defective",
                "value": "damaged"
              },
              {
                "title": "\ud83d\udccf Wrong size / spec",
                "value": "wrong_size"
              },
              {
                "title": "\ud83d\ude15 Not as described",
                "value": "not_as_described"
              },
              {
                "title": "\ud83d\udd04 Changed my mind",
                "value": "changed_mind"
              },
              {
                "title": "\ud83d\udd00 Want a different variant",
                "value": "exchange"
              },
              {
                "title": "\u2753 Other",
                "value": "other"
              }
            ]
          },
          {
            "type": "Input.ChoiceSet",
            "id": "return_action",
            "label": "Preferred Resolution",
            "value": "refund",
            "choices": [
              {
                "title": "\ud83d\udcb0 Full refund",
                "value": "refund"
              },
              {
                "title": "\ud83d\udd04 Exchange for same item",
                "value": "exchange_same"
              },
              {
                "title": "\ud83d\udd00 Exchange for different item",
                "value": "exchange_different"
              },
              {
                "title": "\ud83c\udf9f\ufe0f Store credit",
                "value": "store_credit"
              }
            ]
          },
          {
            "type": "Input.Text",
            "id": "return_notes",
            "label": "Additional Details",
            "placeholder": "Describe the issue...",
            "isMultiline": true
          },
          {
            "type": "Input.Toggle",
            "id": "return_photos",
            "title": "I have photos of the issue to attach",
            "value": "false"
          },
          {
            "type": "ActionSet",
            "spacing": "Medium",
            "actions": [
              {
                "type": "Action.Submit",
                "title": "\ud83d\udce4 Submit Return Request",
                "style": "positive",
                "data": {
                  "action": "submit_return",
                  "demo_mode": true
                }
              },
              {
                "type": "Action.ToggleVisibility",
                "title": "\u2190 Back",
                "targetElements": [
                  {
                    "elementId": "returnOrder",
                    "isVisible": false
                  },
                  {
                    "elementId": "orderMenu",
                    "isVisible": true
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "Container",
        "id": "orderHistory",
        "isVisible": false,
        "items": [
          {
            "type": "TextBlock",
            "text": "\ud83d\udccb Recent Orders",
            "size": "Large",
            "weight": "Bolder",
            "color": "Accent"
          },
          {
            "type": "Container",
            "style": "warning",
            "items": [
              {
                "type": "ColumnSet",
                "columns": [
                  {
                    "type": "Column",
                    "width": "stretch",
                    "items": [
                      {
                        "type": "TextBlock",
                        "text": "USB-C Docking Station",
                        "weight": "Bolder"
                      },
                      {
                        "type": "TextBlock",
                        "text": "ORD-2026-04-0892  \u2022  Apr 8  \u2022  Rp 1,245,000",
                        "size": "Small",
                        "isSubtle": true,
                        "spacing": "None",
                        "wrap": true
                      }
                    ]
                  },
                  {
                    "type": "Column",
                    "width": "auto",
                    "items": [
                      {
                        "type": "TextBlock",
                        "text": "\ud83d\udef5 Delivery",
                        "weight": "Bolder",
                        "color": "Warning",
                        "size": "Small"
                      }
                    ],
                    "verticalContentAlignment": "Center"
                  }
                ]
              }
            ]
          },
          {
            "type": "Container",
            "style": "good",
            "separator": true,
            "items": [
              {
                "type": "ColumnSet",
                "columns": [
                  {
                    "type": "Column",
                    "width": "stretch",
                    "items": [
                      {
                        "type": "TextBlock",
                        "text": "Mechanical Keyboard (Keychron K8)",
                        "weight": "Bolder"
                      },
                      {
                        "type": "TextBlock",
                        "text": "ORD-2026-03-0741  \u2022  Mar 22  \u2022  Rp 1,890,000",
                        "size": "Small",
                        "isSubtle": true,
                        "spacing": "None",
                        "wrap": true
                      }
                    ]
                  },
                  {
                    "type": "Column",
                    "width": "auto",
                    "items": [
                      {
                        "type": "TextBlock",
                        "text": "\u2705 Delivered",
                        "color": "Good",
                        "weight": "Bolder",
                        "size": "Small"
                      }
                    ],
                    "verticalContentAlignment": "Center"
                  }
                ]
              }
            ]
          },
          {
            "type": "Container",
            "style": "good",
            "separator": true,
            "items": [
              {
                "type": "ColumnSet",
                "columns": [
                  {
                    "type": "Column",
                    "width": "stretch",
                    "items": [
                      {
                        "type": "TextBlock",
                        "text": "Monitor Arm (NB F80)",
                        "weight": "Bolder"
                      },
                      {
                        "type": "TextBlock",
                        "text": "ORD-2026-03-0698  \u2022  Mar 15  \u2022  Rp 425,000",
                        "size": "Small",
                        "isSubtle": true,
                        "spacing": "None",
                        "wrap": true
                      }
                    ]
                  },
                  {
                    "type": "Column",
                    "width": "auto",
                    "items": [
                      {
                        "type": "TextBlock",
                        "text": "\u2705 Delivered",
                        "color": "Good",
                        "weight": "Bolder",
                        "size": "Small"
                      }
                    ],
                    "verticalContentAlignment": "Center"
                  }
                ]
              }
            ]
          },
          {
            "type": "ActionSet",
            "spacing": "Medium",
            "actions": [
              {
                "type": "Action.Submit",
                "title": "\ud83d\udd04 Reorder Last Item",
                "data": {
                  "action": "reorder",
                  "order_id": "ORD-2026-04-0892",
                  "demo_mode": true
                }
              },
              {
                "type": "Action.ToggleVisibility",
                "title": "\u2190 Back",
                "targetElements": [
                  {
                    "elementId": "orderHistory",
                    "isVisible": false
                  },
                  {
                    "elementId": "orderMenu",
                    "isVisible": true
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  },
  "notes": "Single-card multi-section app using Action.ToggleVisibility for navigation. All sections hidden by default (isVisible:false) except the main view. Card version 1.5 for broad host compatibility."
}