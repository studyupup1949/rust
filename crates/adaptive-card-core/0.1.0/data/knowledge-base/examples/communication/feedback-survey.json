                    "spacing": "None",
                    "size": "Small"
                  }
                ]
              },
              {
                "type": "Column",
                "width": "1",
                "items": [
                  {
                    "type": "TextBlock",
                    "text": "Wk 14",
                    "size": "Small",
                    "horizontalAlignment": "Center",
                    "weight": "Bolder"
                  },
                  {
                    "type": "TextBlock",
                    "text": "\ud83d\ude10",
                    "horizontalAlignment": "Center",
                    "spacing": "None",
                    "size": "Large"
                  },
                  {
                    "type": "TextBlock",
                    "text": "3.5",
                    "horizontalAlignment": "Center",
                    "spacing": "None",
                    "size": "Small"
                  }
                ]
              },
              {
                "type": "Column",
                "width": "1",
                "items": [
                  {
                    "type": "TextBlock",
                    "text": "Wk 15",
                    "size": "Small",
                    "horizontalAlignment": "Center",
                    "weight": "Bolder"
                  },
                  {
                    "type": "TextBlock",
                    "text": "\ud83d\ude42",
                    "horizontalAlignment": "Center",
                    "spacing": "None",
                    "size": "Large"
                  },
                  {
                    "type": "TextBlock",
                    "text": "3.9",
                    "horizontalAlignment": "Center",
                    "spacing": "None",
                    "size": "Small"
                  }
                ]
              }
            ]
          },
          {
            "type": "FactSet",
            "spacing": "Medium",
            "facts": [
              {
                "title": "eNPS Score",
                "value": "+32 (Good) \u2014 \u2b06\ufe0f from +28 last month"
              },
              {
                "title": "Response Rate",
                "value": "86% (6 of 7 members)"
              },
              {
                "title": "Top Concern",
                "value": "Workload distribution"
              },
              {
                "title": "Top Positive",
