              },
              {
                "title": "Suggestions Received",
                "value": "4 this month (2 actioned)"
              }
            ]
          },
          {
            "type": "ActionSet",
            "spacing": "Medium",
            "actions": [
              {
                "type": "Action.Submit",
                "title": "\ud83d\udce5 Full Sentiment Report",
                "data": {
                  "action": "export_sentiment",
                  "demo_mode": true
                }
              },
              {
                "type": "Action.ToggleVisibility",
                "title": "\u2190 Back",
                "targetElements": [
                  {
                    "elementId": "sentiment",
                    "isVisible": false
                  },
                  {
                    "elementId": "surveyMenu",
                    "isVisible": true
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  },
  "notes": "Multi-section card using Action.ToggleVisibility for in-card navigation. All non-main sections hidden by default."
}