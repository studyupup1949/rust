          {
            "type": "ActionSet",
            "spacing": "Medium",
            "actions": [
              {
                "type": "Action.Submit",
                "title": "\ud83d\udce5 Download Full Report",
                "data": {
                  "action": "download_kpi_report",
                  "demo_mode": true
                }
              },
              {
                "type": "Action.ToggleVisibility",
                "title": "\u2190 Back",
                "targetElements": [
                  {
                    "elementId": "kpiPersonal",
                    "isVisible": false
                  },
                  {
                    "elementId": "kpiMenu",
                    "isVisible": true
                  }
                ]
