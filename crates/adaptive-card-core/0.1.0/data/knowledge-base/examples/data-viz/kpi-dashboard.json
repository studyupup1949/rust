{
  "id": "data-viz/kpi-dashboard",
  "title": "KPI Dashboard \u2014 Metrics Grid with Trends and Alerts",
  "description": "Executive KPI dashboard with metric cards (revenue, users, conversion), trend indicators (up/down arrows with percentages), status colors (good/warning/attention), and drill-down actions. Uses ColumnSet grid for KPIs, TextBlock ExtraLarge for values, and color-coded Container styles.",
  "category": "data-viz",
  "tags": [
    "dashboard",
    "kpi",
    "metrics",
    "analytics",
    "data-viz",
    "executive",
    "trends",
    "performance",
    "reporting"
  ],
  "use_cases": [
    "Executive dashboard with key metrics",
    "Sales pipeline visualization",
    "Operational health monitoring",
    "Weekly business review"
  ],
  "host_targets": [
    "generic",
    "teams",
    "web_chat"
  ],
  "complexity": "intermediate",
  "card": {
    "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
    "type": "AdaptiveCard",
    "version": "1.5",
    "metadata": {
      "webUrl": "https://greentic.io/cards/kpi-dashboard",
      "demo_mode": true
    },
    "body": [
      {
        "type": "Container",
        "id": "kpiMenu",
        "isVisible": true,
        "style": "emphasis",
        "bleed": true,
        "items": [
          {
            "type": "ColumnSet",
            "columns": [
              {
                "type": "Column",
                "width": "auto",
                "items": [
                  {
                    "type": "Image",
                    "url": "https://img.icons8.com/fluency/96/combo-chart.png",
                    "size": "Medium"
                  }
                ],
                "verticalContentAlignment": "Center"
              },
              {
                "type": "Column",
                "width": "stretch",
                "items": [
                  {
                    "type": "TextBlock",
                    "text": "KPI Dashboard",
                    "size": "ExtraLarge",
                    "weight": "Bolder",
                    "color": "Accent"
                  },
                  {
                    "type": "TextBlock",
                    "text": "Track your personal and team performance metrics.",
                    "spacing": "None",
                    "isSubtle": true,
                    "wrap": true
                  }
                ]
              }
            ]
          },
          {
            "type": "ActionSet",
            "spacing": "Medium",
            "actions": [
              {
                "type": "Action.ToggleVisibility",
                "title": "\ud83d\udc64 My KPIs",
                "style": "positive",
                "targetElements": [
                  {
                    "elementId": "kpiMenu",
                    "isVisible": false
                  },
                  {
                    "elementId": "kpiPersonal",
                    "isVisible": true
                  }
                ]
              },
              {
                "type": "Action.ToggleVisibility",
                "title": "\ud83d\udc65 Team Dashboard",
                "targetElements": [
                  {
                    "elementId": "kpiMenu",
                    "isVisible": false
                  },
                  {
                    "elementId": "kpiTeam",
                    "isVisible": true
                  }
                ]
              },
              {
                "type": "Action.ToggleVisibility",
                "title": "\ud83d\udcca Project Health",
                "targetElements": [
                  {
                    "elementId": "kpiMenu",
                    "isVisible": false
                  },
                  {
                    "elementId": "kpiProject",
                    "isVisible": true
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "Container",
        "id": "kpiPersonal",
        "isVisible": false,
