              },
              {
                "type": "Column",
                "width": "1",
                "style": "good",
                "items": [
                  {
                    "type": "TextBlock",
                    "text": "On-Time",
                    "size": "Small",
                    "isSubtle": true,
                    "horizontalAlignment": "Center"
