                    "size": "Small",
                    "isSubtle": true,
                    "horizontalAlignment": "Center"
                  },
                  {
                    "type": "TextBlock",
                    "text": "87%",
                    "weight": "Bolder",
                    "size": "ExtraLarge",
                    "color": "Good",
                    "horizontalAlignment": "Center",
                    "spacing": "None"
                  },
                  {
                    "type": "TextBlock",
                    "text": "Target: 80%",
                    "size": "Small",
                    "isSubtle": true,
                    "horizontalAlignment": "Center",
                    "spacing": "None"
                  }
