                    ]
                  },
                  {
                    "type": "Column",
                    "width": "auto",
                    "items": [
                      {
                        "type": "TextBlock",
                        "text": "\ud83d\udd34 Overdue",
                        "color": "Attention",
                        "weight": "Bolder",
                        "size": "Small"
                      }
                    ],
                    "verticalContentAlignment": "Center"
                  }
                ]
              }
            ]
          },
          {
            "type": "Container",
            "style": "warning",
            "separator": true,
            "items": [
              {
                "type": "ColumnSet",
                "columns": [
                  {
                    "type": "Column",
                    "width": "stretch",
                    "items": [
                      {
                        "type": "TextBlock",
                        "text": "Contabo VPS \u2014 Quarterly",
                        "weight": "Bolder"
                      },
                      {
                        "type": "TextBlock",
                        "text": "\u2601\ufe0f Cloud  \u2022  \u20ac45.00  \u2022  Due: Apr 25",
                        "size": "Small",
                        "isSubtle": true,
                        "spacing": "None",
                        "wrap": true
                      }
                    ]
                  },
                  {
                    "type": "Column",
                    "width": "auto",
                    "items": [
                      {
                        "type": "TextBlock",
                        "text": "\u23f3 Pending",
                        "color": "Warning",
                        "weight": "Bolder",
                        "size": "Small"
                      }
                    ],
                    "verticalContentAlignment": "Center"
                  }
                ]
              }
            ]
          },
          {
            "type": "Input.ChoiceSet",
            "id": "inv_approve_select",
            "label": "Select invoice",
            "isRequired": true,
            "choices": [
              {
                "title": "Azure April \u2014 Rp 18.5M (OVERDUE)",
                "value": "azure_apr"
              },
              {
                "title": "Contabo VPS \u2014 \u20ac45",
                "value": "contabo_q2"
              }
            ]
          },
          {
            "type": "Input.ChoiceSet",
            "id": "inv_approve_action",
            "label": "Action",
            "isRequired": true,
            "choices": [
              {
                "title": "\u2705 Approve for payment",
                "value": "approve"
              },
              {
                "title": "\u23f8\ufe0f Hold \u2014 Need more info",
                "value": "hold"
              },
              {
                "title": "\u274c Reject",
                "value": "reject"
              }
            ]
          },
          {
            "type": "Input.Text",
            "id": "inv_approve_notes",
            "label": "Comments",
            "isMultiline": true
          },
          {
            "type": "ActionSet",
            "spacing": "Medium",
            "actions": [
              {
                "type": "Action.Submit",
                "title": "\ud83d\udce8 Submit Decision",
                "style": "positive",
                "data": {
                  "action": "approve_invoice",
                  "demo_mode": true
                }
              },
              {
                "type": "Action.ToggleVisibility",
                "title": "\u2190 Back",
                "targetElements": [
                  {
                    "elementId": "invApprove",
                    "isVisible": false
                  },
                  {
                    "elementId": "invMenu",
                    "isVisible": true
                  }
                ]
              }
            ]
          }
        ]
      },
