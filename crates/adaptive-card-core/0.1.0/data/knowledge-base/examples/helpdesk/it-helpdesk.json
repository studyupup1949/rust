{
  "id": "helpdesk/it-helpdesk",
  "title": "IT Helpdesk \u2014 Submit Tickets, Track Status, Knowledge Base",
  "description": "IT support portal with new ticket submission form (category, priority, description, screenshot toggle), ticket tracking with status indicators, and self-service knowledge base with common solutions. Uses ToggleVisibility for section switching, FactSet for ticket details, Container styles for priority levels.",
  "category": "helpdesk",
  "tags": [
    "helpdesk",
    "it",
    "support",
    "ticket",
    "form",
    "status",
    "knowledge-base",
    "toggle-visibility",
    "priority"
  ],
  "use_cases": [
    "Submit new IT support ticket with priority and category",
    "Track existing ticket status",
    "Browse common IT solutions and troubleshooting",
    "Self-service IT portal with multiple sections"
  ],
  "host_targets": [
    "generic",
    "teams",
    "web_chat"
  ],
  "complexity": "advanced",
  "card": {
    "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
    "type": "AdaptiveCard",
    "version": "1.5",
    "metadata": {
      "webUrl": "https://greentic.io/cards/it-helpdesk",
      "demo_mode": true
    },
    "body": [
      {
        "type": "Container",
        "id": "helpdeskMenu",
        "isVisible": true,
        "style": "emphasis",
        "bleed": true,
        "items": [
          {
            "type": "ColumnSet",
            "columns": [
              {
                "type": "Column",
                "width": "auto",
                "items": [
                  {
                    "type": "Image",
                    "url": "https://img.icons8.com/fluency/96/technical-support.png",
                    "size": "Medium"
                  }
                ],
                "verticalContentAlignment": "Center"
              },
              {
                "type": "Column",
                "width": "stretch",
                "items": [
                  {
                    "type": "TextBlock",
                    "text": "IT Helpdesk",
                    "size": "ExtraLarge",
                    "weight": "Bolder",
                    "color": "Accent"
                  },
                  {
                    "type": "TextBlock",
                    "text": "Submit tickets, track issues, or browse solutions.",
                    "spacing": "None",
                    "isSubtle": true,
                    "wrap": true
                  }
                ]
              }
            ]
          },
          {
            "type": "ActionSet",
            "spacing": "Medium",
            "actions": [
              {
                "type": "Action.ToggleVisibility",
                "title": "\ud83c\udfab New Ticket",
                "style": "positive",
                "targetElements": [
                  {
                    "elementId": "helpdeskMenu",
                    "isVisible": false
                  },
                  {
                    "elementId": "newTicket",
                    "isVisible": true
                  }
                ]
              },
              {
                "type": "Action.ToggleVisibility",
                "title": "\ud83d\udd0d Track Ticket",
                "targetElements": [
                  {
                    "elementId": "helpdeskMenu",
                    "isVisible": false
                  },
                  {
                    "elementId": "trackTicket",
                    "isVisible": true
                  }
                ]
              },
              {
                "type": "Action.ToggleVisibility",
                "title": "\ud83d\udcda Knowledge Base",
                "targetElements": [
                  {
                    "elementId": "helpdeskMenu",
                    "isVisible": false
                  },
                  {
                    "elementId": "knowledgeBase",
                    "isVisible": true
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "Container",
        "id": "newTicket",
        "isVisible": false,
        "items": [
          {
            "type": "TextBlock",
            "text": "\ud83c\udfab Submit New Ticket",
            "size": "Large",
            "weight": "Bolder",
            "color": "Accent"
          },
          {
            "type": "Input.ChoiceSet",
            "id": "ticket_category",
            "label": "Category",
            "isRequired": true,
            "errorMessage": "Select a category.",
            "choices": [
              {
                "title": "\ud83d\udcbb Hardware Issue",
                "value": "hardware"
              },
              {
                "title": "\ud83d\udda5\ufe0f Software / App Issue",
                "value": "software"
              },
              {
                "title": "\ud83c\udf10 Network / VPN / Connectivity",
                "value": "network"
              },
              {
                "title": "\ud83d\udd11 Account / Password / Access",
                "value": "access"
              },
              {
                "title": "\ud83d\udce7 Email / Calendar Issue",
                "value": "email"
              },
              {
                "title": "\ud83d\udda8\ufe0f Printer / Peripheral",
                "value": "printer"
              },
              {
                "title": "\ud83d\udce6 New Equipment Request",
                "value": "new_equipment"
              },
              {
                "title": "\ud83d\udee1\ufe0f Security Concern",
                "value": "security"
              },
              {
                "title": "\u2753 Other",
                "value": "other"
              }
            ]
          },
          {
            "type": "Input.ChoiceSet",
            "id": "ticket_priority",
            "label": "Priority",
            "value": "medium",
            "choices": [
              {
                "title": "\ud83d\udd34 Critical \u2014 Cannot work at all",
                "value": "critical"
              },
              {
                "title": "\ud83d\udfe0 High \u2014 Major feature broken",
                "value": "high"
              },
              {
                "title": "\ud83d\udfe1 Medium \u2014 Can work with workaround",
                "value": "medium"
              },
              {
                "title": "\ud83d\udfe2 Low \u2014 Minor inconvenience",
                "value": "low"
              }
            ]
          },
          {
            "type": "Input.Text",
            "id": "ticket_subject",
            "label": "Subject",
            "placeholder": "Brief summary of the issue",
            "isRequired": true,
            "errorMessage": "Please provide a subject."
          },
          {
            "type": "Input.Text",
            "id": "ticket_description",
            "label": "Description",
            "placeholder": "Describe the issue in detail:\n- What happened?\n- When did it start?\n- Steps to reproduce?\n- Any error messages?",
            "isMultiline": true,
            "isRequired": true,
            "errorMessage": "Please describe the issue."
          },
          {
            "type": "Input.ChoiceSet",
            "id": "ticket_device",
            "label": "Affected Device",
            "value": "laptop",
            "choices": [
              {
                "title": "\ud83d\udcbb Laptop",
                "value": "laptop"
              },
              {
                "title": "\ud83d\udda5\ufe0f Desktop",
                "value": "desktop"
              },
              {
                "title": "\ud83d\udcf1 Mobile / Tablet",
                "value": "mobile"
              },
              {
                "title": "\u2601\ufe0f Cloud / Web App",
                "value": "cloud"
              },
              {
                "title": "\ud83d\udda8\ufe0f Printer / Peripheral",
                "value": "peripheral"
              }
            ]
          },
          {
            "type": "Input.Toggle",
            "id": "ticket_remote",
            "title": "I am working remotely",
            "value": "true"
          },
          {
            "type": "Input.ChoiceSet",
            "id": "ticket_preferred_contact",
            "label": "Preferred Contact Method",
            "value": "chat",
            "choices": [
              {
                "title": "\ud83d\udcac Chat / Messaging",
                "value": "chat"
              },
              {
                "title": "\ud83d\udce7 Email",
                "value": "email"
              },
              {
                "title": "\ud83d\udcde Phone Call",
                "value": "phone"
              },
              {
                "title": "\ud83d\udda5\ufe0f Remote Desktop Session",
                "value": "remote_desktop"
              }
            ]
          },
          {
            "type": "ActionSet",
            "spacing": "Medium",
            "actions": [
              {
                "type": "Action.Submit",
                "title": "\ud83d\udce4 Submit Ticket",
                "style": "positive",
                "data": {
                  "action": "submit_ticket",
                  "demo_mode": true
                }
              },
              {
                "type": "Action.ToggleVisibility",
                "title": "\u2190 Back",
                "targetElements": [
                  {
                    "elementId": "newTicket",
                    "isVisible": false
                  },
                  {
                    "elementId": "helpdeskMenu",
                    "isVisible": true
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "Container",
        "id": "trackTicket",
        "isVisible": false,
        "items": [
          {
            "type": "TextBlock",
            "text": "\ud83d\udd0d Track Your Tickets",
            "size": "Large",
            "weight": "Bolder",
            "color": "Accent"
          },
          {
            "type": "Container",
            "style": "warning",
            "items": [
              {
                "type": "ColumnSet",
                "columns": [
                  {
                    "type": "Column",
                    "width": "stretch",
                    "items": [
                      {
                        "type": "TextBlock",
                        "text": "TKT-2026-0891",
                        "weight": "Bolder",
                        "size": "Small"
                      },
                      {
                        "type": "TextBlock",
                        "text": "VPN disconnects every 30 minutes",
                        "weight": "Bolder",
                        "spacing": "None"
                      },
                      {
                        "type": "TextBlock",
                        "text": "\ud83c\udf10 Network  \u2022  \ud83d\udfe0 High  \u2022  Submitted Apr 10",
                        "size": "Small",
                        "isSubtle": true,
                        "spacing": "None",
                        "wrap": true
                      }
                    ]
                  },
                  {
                    "type": "Column",
                    "width": "auto",
                    "items": [
                      {
                        "type": "TextBlock",
                        "text": "\ud83d\udd27 In Progress",
                        "color": "Warning",
                        "weight": "Bolder"
                      },
                      {
                        "type": "TextBlock",
                        "text": "Assigned: IT-Net",
                        "size": "Small",
                        "isSubtle": true,
                        "spacing": "None"
                      }
                    ],
                    "verticalContentAlignment": "Center"
                  }
                ]
              }
            ]
          },
          {
            "type": "Container",
            "style": "good",
            "separator": true,
            "items": [
              {
                "type": "ColumnSet",
                "columns": [
                  {
                    "type": "Column",
                    "width": "stretch",
                    "items": [
                      {
                        "type": "TextBlock",
                        "text": "TKT-2026-0867",
                        "weight": "Bolder",
                        "size": "Small"
                      },
                      {
                        "type": "TextBlock",
                        "text": "Request new USB-C dock",
                        "weight": "Bolder",
                        "spacing": "None"
                      },
                      {
                        "type": "TextBlock",
                        "text": "\ud83d\udce6 Equipment  \u2022  \ud83d\udfe2 Low  \u2022  Submitted Apr 3",
                        "size": "Small",
                        "isSubtle": true,
                        "spacing": "None",
                        "wrap": true
                      }
                    ]
                  },
                  {
                    "type": "Column",
                    "width": "auto",
                    "items": [
                      {
                        "type": "TextBlock",
                        "text": "\ud83d\udce6 Ordered",
                        "color": "Good",
                        "weight": "Bolder"
                      },
                      {
                        "type": "TextBlock",
                        "text": "ETA: Apr 18",
                        "size": "Small",
                        "isSubtle": true,
                        "spacing": "None"
                      }
                    ],
                    "verticalContentAlignment": "Center"
                  }
                ]
              }
            ]
          },
          {
            "type": "Input.Text",
            "id": "ticket_lookup",
            "label": "Look up a specific ticket",
            "placeholder": "e.g. TKT-2026-0891",
            "spacing": "Medium"
          },
          {
            "type": "ActionSet",
            "actions": [
              {
                "type": "Action.Submit",
                "title": "\ud83d\udd0d Look Up",
                "data": {
                  "action": "lookup_ticket",
                  "demo_mode": true
                }
              },
              {
                "type": "Action.Submit",
                "title": "\u2b06\ufe0f Escalate TKT-0891",
                "style": "destructive",
                "data": {
                  "action": "escalate_ticket",
                  "ticket_id": "TKT-2026-0891",
                  "demo_mode": true
                }
              },
              {
                "type": "Action.ToggleVisibility",
                "title": "\u2190 Back",
                "targetElements": [
                  {
                    "elementId": "trackTicket",
                    "isVisible": false
                  },
                  {
                    "elementId": "helpdeskMenu",
                    "isVisible": true
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "Container",
        "id": "knowledgeBase",
        "isVisible": false,
        "items": [
          {
            "type": "TextBlock",
            "text": "\ud83d\udcda Knowledge Base \u2014 Common Solutions",
            "size": "Large",
            "weight": "Bolder",
            "color": "Accent"
          },
          {
            "type": "Input.Text",
            "id": "kb_search",
            "label": "Search articles",
            "placeholder": "e.g. VPN setup, password reset, printer..."
          },
          {
            "type": "TextBlock",
            "text": "Popular Articles",
            "weight": "Bolder",
            "spacing": "Medium"
          },
          {
            "type": "FactSet",
            "facts": [
              {
                "title": "KB-001",
                "value": "\ud83d\udd11 How to reset your password (2 min)"
              },
              {
                "title": "KB-002",
                "value": "\ud83c\udf10 VPN setup for remote workers (5 min)"
              },
              {
                "title": "KB-003",
                "value": "\ud83d\udda8\ufe0f Connect to office printer remotely (3 min)"
              },
              {
                "title": "KB-004",
                "value": "\ud83d\udce7 Set up email on mobile device (2 min)"
              },
              {
                "title": "KB-005",
                "value": "\ud83d\udcbb Request software installation (1 min)"
              },
              {
                "title": "KB-006",
                "value": "\ud83d\udee1\ufe0f Enable 2FA on your account (3 min)"
              }
            ]
          },
          {
            "type": "ActionSet",
            "spacing": "Medium",
            "actions": [
              {
                "type": "Action.Submit",
                "title": "\ud83d\udd0d Search",
                "style": "positive",
                "data": {
                  "action": "search_kb",
                  "demo_mode": true
                }
              },
              {
                "type": "Action.ToggleVisibility",
                "title": "\u2190 Back",
                "targetElements": [
                  {
                    "elementId": "knowledgeBase",
                    "isVisible": false
                  },
                  {
                    "elementId": "helpdeskMenu",
                    "isVisible": true
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  },
  "notes": "Single-card multi-section app using Action.ToggleVisibility for navigation. All sections hidden by default (isVisible:false) except the main view. Card version 1.5 for broad host compatibility."
}