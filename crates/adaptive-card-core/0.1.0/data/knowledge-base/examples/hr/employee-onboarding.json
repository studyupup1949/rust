{
  "id": "hr/employee-onboarding",
  "title": "Employee Onboarding \u2014 Welcome, Checklist, and Document Collection",
  "description": "New hire onboarding card with welcome section, personal info form, document upload checklist, IT setup progress, buddy assignment, and first-week schedule. Uses ToggleVisibility for step navigation, progress indicators, and checklist patterns.",
  "category": "hr",
  "tags": [
    "hr",
    "onboarding",
    "employee",
    "checklist",
    "welcome",
    "new-hire",
    "form",
    "progress",
    "toggle-visibility"
  ],
  "use_cases": [
    "New employee first-day experience",
    "Document collection and signing",
    "IT setup tracking",
    "Onboarding progress dashboard",
    "Buddy/mentor assignment"
  ],
  "host_targets": [
    "generic",
    "teams",
    "web_chat"
  ],
  "complexity": "advanced",
  "card": {
    "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
    "type": "AdaptiveCard",
    "version": "1.5",
    "metadata": {
      "webUrl": "https://greentic.io/cards/employee-onboarding",
      "demo_mode": true
    },
    "body": [
      {
        "type": "Container",
        "id": "onboardMenu",
        "isVisible": true,
        "style": "emphasis",
        "bleed": true,
        "items": [
          {
            "type": "ColumnSet",
            "columns": [
              {
                "type": "Column",
                "width": "auto",
                "items": [
                  {
                    "type": "Image",
                    "url": "https://img.icons8.com/fluency/96/handshake.png",
                    "size": "Medium"
                  }
                ],
                "verticalContentAlignment": "Center"
              },
              {
                "type": "Column",
                "width": "stretch",
                "items": [
                  {
                    "type": "TextBlock",
                    "text": "Employee Onboarding",
                    "size": "ExtraLarge",
                    "weight": "Bolder",
                    "color": "Accent"
                  },
                  {
                    "type": "TextBlock",
                    "text": "Welcome aboard! Complete your onboarding steps below.",
                    "spacing": "None",
                    "isSubtle": true,
                    "wrap": true
                  }
                ]
              }
            ]
          },
          {
            "type": "Container",
            "style": "good",
            "spacing": "Medium",
            "items": [
              {
                "type": "TextBlock",
                "text": "Onboarding Progress",
                "weight": "Bolder"
              },
              {
                "type": "ColumnSet",
                "columns": [
                  {
                    "type": "Column",
                    "width": "stretch",
                    "items": [
                      {
                        "type": "TextBlock",
                        "text": "3 of 6 steps completed",
                        "size": "Small"
                      }
                    ]
                  },
                  {
                    "type": "Column",
                    "width": "auto",
                    "items": [
                      {
                        "type": "TextBlock",
                        "text": "50%",
                        "weight": "Bolder",
                        "color": "Good",
                        "size": "Large"
                      }
                    ]
                  }
                ]
              }
            ]
          },
          {
            "type": "ActionSet",
            "spacing": "Medium",
            "actions": [
              {
                "type": "Action.ToggleVisibility",
                "title": "\ud83d\udccb Personal Info & Documents",
                "style": "positive",
                "targetElements": [
                  {
                    "elementId": "onboardMenu",
                    "isVisible": false
                  },
                  {
                    "elementId": "onboardDocs",
                    "isVisible": true
                  }
                ]
              },
              {
                "type": "Action.ToggleVisibility",
                "title": "\ud83d\udcbb IT Setup & Access",
                "targetElements": [
                  {
                    "elementId": "onboardMenu",
                    "isVisible": false
                  },
                  {
                    "elementId": "onboardIT",
                    "isVisible": true
                  }
                ]
              },
              {
                "type": "Action.ToggleVisibility",
                "title": "\ud83d\udc65 Team Introduction",
                "targetElements": [
                  {
                    "elementId": "onboardMenu",
                    "isVisible": false
                  },
                  {
                    "elementId": "onboardTeam",
                    "isVisible": true
                  }
                ]
              },
              {
                "type": "Action.ToggleVisibility",
                "title": "\ud83d\udcda Policies & Compliance",
                "targetElements": [
                  {
                    "elementId": "onboardMenu",
                    "isVisible": false
                  },
                  {
                    "elementId": "onboardPolicy",
                    "isVisible": true
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "Container",
        "id": "onboardDocs",
        "isVisible": false,
        "items": [
          {
            "type": "TextBlock",
            "text": "\ud83d\udccb Personal Info & Documents",
            "size": "Large",
            "weight": "Bolder",
            "color": "Accent"
          },
          {
            "type": "TextBlock",
            "text": "Please provide your details and upload required documents.",
            "isSubtle": true,
            "wrap": true,
            "spacing": "Small"
          },
          {
            "type": "Input.Text",
            "id": "onb_full_name",
            "label": "Full Legal Name",
            "placeholder": "As per KTP / Passport",
            "isRequired": true
          },
          {
            "type": "Input.Text",
            "id": "onb_nik",
            "label": "NIK (KTP Number)",
            "placeholder": "16-digit number",
            "isRequired": true
          },
          {
            "type": "Input.Date",
            "id": "onb_dob",
            "label": "Date of Birth",
            "isRequired": true
          },
          {
            "type": "Input.ChoiceSet",
            "id": "onb_marital",
            "label": "Marital Status",
            "choices": [
              {
                "title": "Single",
                "value": "single"
              },
              {
                "title": "Married",
                "value": "married"
              },
              {
                "title": "Divorced",
                "value": "divorced"
              }
            ]
          },
          {
            "type": "Input.Text",
            "id": "onb_address",
            "label": "Current Address",
            "isMultiline": true,
            "isRequired": true
          },
          {
            "type": "Input.Text",
            "id": "onb_emergency_name",
            "label": "Emergency Contact \u2014 Name",
            "isRequired": true
          },
          {
            "type": "Input.Text",
            "id": "onb_emergency_phone",
            "label": "Emergency Contact \u2014 Phone",
            "isRequired": true
          },
          {
            "type": "Input.ChoiceSet",
            "id": "onb_emergency_relation",
            "label": "Relationship",
            "choices": [
              {
                "title": "Spouse",
                "value": "spouse"
              },
              {
                "title": "Parent",
                "value": "parent"
              },
              {
                "title": "Sibling",
                "value": "sibling"
              },
              {
                "title": "Other",
                "value": "other"
              }
            ]
          },
          {
            "type": "TextBlock",
            "text": "Required Documents",
            "weight": "Bolder",
            "spacing": "Medium"
          },
          {
            "type": "FactSet",
            "facts": [
              {
                "title": "KTP",
                "value": "\u2705 Uploaded"
              },
              {
                "title": "NPWP",
                "value": "\u2705 Uploaded"
              },
              {
                "title": "BPJS Kesehatan",
                "value": "\u2705 Uploaded"
              },
              {
                "title": "Ijazah Terakhir",
                "value": "\u2b1c Not yet"
              },
              {
                "title": "Pas Foto 3x4",
                "value": "\u2b1c Not yet"
              },
              {
                "title": "Bank Account Details",
                "value": "\u2b1c Not yet"
              }
            ]
          },
          {
            "type": "Input.Text",
            "id": "onb_bank_name",
            "label": "Bank Name",
            "placeholder": "e.g. BCA, Mandiri, BRI"
          },
          {
            "type": "Input.Text",
            "id": "onb_bank_account",
            "label": "Account Number",
            "placeholder": "For salary transfer"
          },
          {
            "type": "ActionSet",
            "spacing": "Medium",
            "actions": [
              {
                "type": "Action.Submit",
                "title": "\ud83d\udcbe Save & Continue",
                "style": "positive",
                "data": {
                  "action": "save_onboard_docs",
                  "demo_mode": true
                }
              },
              {
                "type": "Action.ToggleVisibility",
                "title": "\u2190 Back",
                "targetElements": [
                  {
                    "elementId": "onboardDocs",
                    "isVisible": false
                  },
                  {
                    "elementId": "onboardMenu",
                    "isVisible": true
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "Container",
        "id": "onboardIT",
        "isVisible": false,
        "items": [
          {
            "type": "TextBlock",
            "text": "\ud83d\udcbb IT Setup & Access Requests",
            "size": "Large",
            "weight": "Bolder",
            "color": "Accent"
          },
          {
            "type": "TextBlock",
            "text": "Your IT provisioning status and pending access requests.",
            "isSubtle": true,
            "wrap": true,
            "spacing": "Small"
          },
          {
            "type": "FactSet",
            "facts": [
              {
                "title": "Email Account",
                "value": "\u2705 Active \u2014 name@company.co.id"
              },
              {
                "title": "Microsoft 365",
                "value": "\u2705 Licensed"
              },
              {
                "title": "VPN Access",
                "value": "\u2705 Configured"
              },
              {
                "title": "Slack Workspace",
                "value": "\u23f3 Pending invitation"
              },
              {
                "title": "Azure DevOps",
                "value": "\u2b1c Not requested"
              },
              {
                "title": "GitHub Org",
                "value": "\u2b1c Not requested"
              },
              {
                "title": "Laptop / Hardware",
                "value": "\ud83d\udce6 Shipping \u2014 ETA Apr 15"
              }
            ]
          },
          {
            "type": "TextBlock",
            "text": "Request Additional Access",
            "weight": "Bolder",
            "spacing": "Medium"
          },
          {
            "type": "Input.ChoiceSet",
            "id": "onb_access_request",
            "label": "Select tools you need",
            "isMultiLine": true,
            "style": "filtered",
            "choices": [
              {
                "title": "Azure Portal",
                "value": "azure"
              },
              {
                "title": "Azure DevOps",
                "value": "azdo"
              },
              {
                "title": "GitHub Organization",
                "value": "github"
              },
              {
                "title": "Jira / Confluence",
                "value": "jira"
              },
              {
                "title": "Figma",
                "value": "figma"
              },
              {
                "title": "Notion Workspace",
                "value": "notion"
              },
              {
                "title": "AWS Console",
                "value": "aws"
              },
              {
                "title": "Databricks",
                "value": "databricks"
              },
              {
                "title": "Power BI",
                "value": "powerbi"
              }
            ]
          },
          {
            "type": "Input.Text",
            "id": "onb_access_justification",
            "label": "Justification",
            "placeholder": "Why do you need this access?"
          },
          {
            "type": "ActionSet",
            "spacing": "Medium",
            "actions": [
              {
                "type": "Action.Submit",
                "title": "\ud83d\udce4 Request Access",
                "style": "positive",
                "data": {
                  "action": "request_it_access",
                  "demo_mode": true
                }
              },
              {
                "type": "Action.ToggleVisibility",
                "title": "\u2190 Back",
                "targetElements": [
                  {
                    "elementId": "onboardIT",
                    "isVisible": false
                  },
                  {
                    "elementId": "onboardMenu",
                    "isVisible": true
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "Container",
        "id": "onboardTeam",
        "isVisible": false,
        "items": [
          {
            "type": "TextBlock",
            "text": "\ud83d\udc65 Meet Your Team",
            "size": "Large",
            "weight": "Bolder",
            "color": "Accent"
          },
          {
            "type": "Container",
            "style": "emphasis",
            "items": [
              {
                "type": "TextBlock",
                "text": "Your Manager",
                "weight": "Bolder",
                "size": "Small",
                "isSubtle": true
              },
              {
                "type": "TextBlock",
                "text": "Ahmad Rizki \u2014 Head of Engineering",
                "weight": "Bolder",
                "spacing": "None"
              },
              {
                "type": "TextBlock",
                "text": "\ud83d\udce7 ahmad.rizki@company.co.id  \u2022  \ud83d\udcac Slack: @ahmad",
                "size": "Small",
                "isSubtle": true,
                "spacing": "None",
                "wrap": true
              }
            ]
          },
          {
            "type": "Container",
            "style": "default",
            "separator": true,
            "items": [
              {
                "type": "TextBlock",
                "text": "Team Members",
                "weight": "Bolder",
                "size": "Small",
                "isSubtle": true
              },
              {
                "type": "FactSet",
                "facts": [
                  {
                    "title": "Dewi Sari",
                    "value": "Senior Data Engineer  \u2022  @dewi"
                  },
                  {
                    "title": "Reza Pratama",
                    "value": "Backend Developer  \u2022  @reza"
                  },
                  {
                    "title": "Siti Nurhaliza",
                    "value": "QA Engineer  \u2022  @siti"
                  },
                  {
                    "title": "Fajar Nugroho",
                    "value": "DevOps Engineer  \u2022  @fajar"
                  }
                ]
              }
            ]
          },
          {
            "type": "TextBlock",
            "text": "Buddy Program",
            "weight": "Bolder",
            "spacing": "Medium"
          },
          {
            "type": "TextBlock",
            "text": "Your onboarding buddy is Reza Pratama. He will help you settle in during your first 2 weeks. Feel free to reach out for any questions!",
            "wrap": true,
            "size": "Small"
          },
          {
            "type": "Input.ChoiceSet",
            "id": "onb_intro_pref",
            "label": "How would you like to meet the team?",
            "value": "video",
            "choices": [
              {
                "title": "\ud83d\udcf9 Group video call",
                "value": "video"
              },
              {
                "title": "\u2615 Virtual coffee 1:1 with each",
                "value": "coffee"
              },
              {
                "title": "\ud83d\udcac Slack introduction only",
                "value": "slack"
              }
            ]
          },
          {
            "type": "ActionSet",
            "spacing": "Medium",
            "actions": [
              {
                "type": "Action.Submit",
                "title": "\ud83d\udce4 Schedule Introductions",
                "style": "positive",
                "data": {
                  "action": "schedule_team_intro",
                  "demo_mode": true
                }
              },
              {
                "type": "Action.ToggleVisibility",
                "title": "\u2190 Back",
                "targetElements": [
                  {
                    "elementId": "onboardTeam",
                    "isVisible": false
                  },
                  {
                    "elementId": "onboardMenu",
                    "isVisible": true
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "Container",
        "id": "onboardPolicy",
        "isVisible": false,
        "items": [
          {
            "type": "TextBlock",
            "text": "\ud83d\udcda Policies & Compliance",
            "size": "Large",
            "weight": "Bolder",
            "color": "Accent"
          },
          {
            "type": "TextBlock",
            "text": "Please read and acknowledge the following company policies.",
            "isSubtle": true,
            "wrap": true,
            "spacing": "Small"
          },
          {
            "type": "Input.Toggle",
            "id": "pol_code_conduct",
            "title": "\u2705 I have read the Code of Conduct",
            "value": "false"
          },
          {
            "type": "Input.Toggle",
            "id": "pol_data_privacy",
            "title": "\u2705 I have read the Data Privacy & Security Policy",
            "value": "false"
          },
          {
            "type": "Input.Toggle",
            "id": "pol_remote_work",
            "title": "\u2705 I have read the Remote Work Guidelines",
            "value": "false"
          },
          {
            "type": "Input.Toggle",
            "id": "pol_leave",
            "title": "\u2705 I have read the Leave & Attendance Policy",
            "value": "false"
          },
          {
            "type": "Input.Toggle",
            "id": "pol_nda",
            "title": "\u2705 I agree to the Non-Disclosure Agreement (NDA)",
            "value": "false"
          },
          {
            "type": "Input.Toggle",
            "id": "pol_anti_bribery",
            "title": "\u2705 I acknowledge the Anti-Bribery & Corruption Policy",
            "value": "false"
          },
          {
            "type": "TextBlock",
            "text": "\u26a0\ufe0f All policies must be acknowledged within your first 5 business days.",
            "size": "Small",
            "color": "Attention",
            "wrap": true,
            "spacing": "Medium"
          },
          {
            "type": "ActionSet",
            "spacing": "Medium",
            "actions": [
              {
                "type": "Action.Submit",
                "title": "\u2705 Submit Acknowledgements",
                "style": "positive",
                "data": {
                  "action": "acknowledge_policies",
                  "demo_mode": true
                }
              },
              {
                "type": "Action.ToggleVisibility",
                "title": "\u2190 Back",
                "targetElements": [
                  {
                    "elementId": "onboardPolicy",
                    "isVisible": false
                  },
                  {
                    "elementId": "onboardMenu",
                    "isVisible": true
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  },
  "notes": "Multi-section card using Action.ToggleVisibility for in-card navigation. All non-main sections hidden by default."
}