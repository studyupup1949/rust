{
  "id": "hr/performance-review",
  "title": "Performance Review \u2014 Goals, Ratings, and Feedback",
  "description": "Performance review card with self-assessment, rating scales for competencies, goal tracking, peer feedback, and manager comments. Uses Input.ChoiceSet for ratings, FactSet for goals, and Container styles for sections.",
  "category": "hr",
  "tags": [
    "hr",
    "performance",
    "review",
    "rating",
    "goals",
    "feedback",
    "appraisal",
    "competency",
    "self-assessment"
  ],
  "use_cases": [
    "Annual performance review cycle",
    "360-degree feedback collection",
    "Goal setting and tracking",
    "Self-assessment and manager review"
  ],
  "host_targets": [
    "generic",
    "teams",
    "web_chat"
  ],
  "complexity": "advanced",
  "card": {
    "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
    "type": "AdaptiveCard",
    "version": "1.5",
    "metadata": {
      "webUrl": "https://greentic.io/cards/performance-review",
      "demo_mode": true
    },
    "body": [
      {
        "type": "Container",
        "id": "prMenu",
        "isVisible": true,
        "style": "emphasis",
        "bleed": true,
        "items": [
          {
            "type": "ColumnSet",
            "columns": [
              {
                "type": "Column",
                "width": "auto",
                "items": [
                  {
                    "type": "Image",
                    "url": "https://img.icons8.com/fluency/96/ratings.png",
                    "size": "Medium"
                  }
                ],
                "verticalContentAlignment": "Center"
              },
              {
                "type": "Column",
                "width": "stretch",
                "items": [
                  {
                    "type": "TextBlock",
                    "text": "Performance Review",
                    "size": "ExtraLarge",
                    "weight": "Bolder",
                    "color": "Accent"
                  },
                  {
                    "type": "TextBlock",
                    "text": "Self-assessment, goal tracking, and 360\u00b0 feedback.",
                    "spacing": "None",
                    "isSubtle": true,
                    "wrap": true
                  }
                ]
              }
            ]
          },
          {
            "type": "Container",
            "style": "good",
            "spacing": "Medium",
            "items": [
              {
                "type": "TextBlock",
                "text": "Review Cycle: Q1 2026 (Jan\u2013Mar)",
                "weight": "Bolder"
              },
              {
                "type": "TextBlock",
                "text": "\u23f3 Self-assessment due: April 18, 2026 (6 days left)",
                "color": "Warning",
                "size": "Small",
                "spacing": "None"
              }
            ]
          },
          {
            "type": "ActionSet",
            "spacing": "Medium",
            "actions": [
              {
                "type": "Action.ToggleVisibility",
                "title": "\ud83d\udcdd Self-Assessment",
                "style": "positive",
                "targetElements": [
                  {
                    "elementId": "prMenu",
                    "isVisible": false
                  },
                  {
                    "elementId": "prSelf",
                    "isVisible": true
                  }
                ]
              },
              {
                "type": "Action.ToggleVisibility",
                "title": "\ud83c\udfaf Goals & OKRs",
                "targetElements": [
                  {
                    "elementId": "prMenu",
                    "isVisible": false
                  },
                  {
                    "elementId": "prGoals",
                    "isVisible": true
                  }
                ]
              },
              {
                "type": "Action.ToggleVisibility",
                "title": "\ud83d\udc65 Peer Feedback",
                "targetElements": [
                  {
                    "elementId": "prMenu",
                    "isVisible": false
                  },
                  {
                    "elementId": "prPeer",
                    "isVisible": true
                  }
                ]
              }
            ]
          }
        ]
      },
