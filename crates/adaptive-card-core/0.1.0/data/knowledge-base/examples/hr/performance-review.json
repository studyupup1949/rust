            "isRequired": true,
            "choices": [
              {
                "title": "\u2b50\u2b50\u2b50\u2b50\u2b50 Exceptional",
                "value": "5"
              },
              {
                "title": "\u2b50\u2b50\u2b50\u2b50 Strong",
                "value": "4"
              },
              {
                "title": "\u2b50\u2b50\u2b50 Solid",
                "value": "3"
              },
              {
                "title": "\u2b50\u2b50 Developing",
                "value": "2"
              },
              {
                "title": "\u2b50 Needs Improvement",
                "value": "1"
