{
  "id": "hr/recruitment",
  "title": "Recruitment Pipeline \u2014 Candidate Tracking and Interview Scheduling",
  "description": "Recruitment dashboard with candidate pipeline stages, resume preview, interview scheduling, feedback collection, and offer management. Uses pipeline visualization, ColumnSet for candidate cards, and form patterns for evaluations.",
  "category": "hr",
  "tags": [
    "hr",
    "recruitment",
    "hiring",
    "candidate",
    "interview",
    "pipeline",
    "ats",
    "job",
    "offer"
  ],
  "use_cases": [
    "Track candidates through hiring stages",
    "Schedule interviews with hiring team",
    "Collect interview feedback",
    "Manage job offers and acceptances"
  ],
  "host_targets": [
    "generic",
    "teams",
    "web_chat"
  ],
  "complexity": "advanced",
  "card": {
    "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
    "type": "AdaptiveCard",
    "version": "1.5",
