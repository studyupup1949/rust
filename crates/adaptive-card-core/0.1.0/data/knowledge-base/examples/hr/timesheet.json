{
  "id": "hr/timesheet",
  "title": "Timesheet \u2014 Weekly Hours Entry with Project Allocation",
  "description": "Timesheet entry card with weekly hours grid by day, project/task allocation with dropdowns, overtime tracking, and submission workflow. Uses ColumnSet for day columns, Input.Number for hours, and status indicators.",
  "category": "hr",
  "tags": [
    "hr",
    "timesheet",
    "hours",
    "project",
    "time-tracking",
    "weekly",
    "form",
    "allocation",
    "payroll"
  ],
  "use_cases": [
    "Employee logs weekly hours per project",
    "Overtime tracking and approval",
    "Project time allocation",
    "Payroll data collection"
  ],
  "host_targets": [
    "generic",
    "teams",
    "web_chat"
  ],
  "complexity": "intermediate",
  "card": {
    "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
    "type": "AdaptiveCard",
    "version": "1.5",
