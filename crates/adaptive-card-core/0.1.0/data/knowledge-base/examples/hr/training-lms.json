            "facts": [
              {
                "title": "Azure Data Engineer (DP-203)",
                "value": "\u2705 Completed Mar 15"
              },
              {
                "title": "Agile Project Management",
                "value": "\u2705 Completed Feb 28"
              },
              {
                "title": "Workplace Safety 2026",
                "value": "\u2705 Completed Jan 10"
              }
