                "size": "Small",
                "isSubtle": true,
                "spacing": "None",
                "wrap": true
              }
            ]
          },
          {
            "type": "Container",
            "style": "default",
            "separator": true,
            "items": [
              {
                "type": "TextBlock",
                "text": "Rust for Production Systems",
                "weight": "Bolder"
              },
              {
                "type": "TextBlock",
                "text": "\ud83d\udcbb Engineering  \u2022  12 hours  \u2022  \u2b50 4.9  \u2022  Advanced",
                "size": "Small",
                "isSubtle": true,
                "spacing": "None",
                "wrap": true
              }
            ]
          },
          {
            "type": "Container",
            "style": "default",
            "separator": true,
            "items": [
              {
                "type": "TextBlock",
                "text": "Leading Remote Teams Effectively",
                "weight": "Bolder"
              },
              {
                "type": "TextBlock",
                "text": "\ud83e\udd1d Leadership  \u2022  4 hours  \u2022  \u2b50 4.5  \u2022  Beginner-friendly",
                "size": "Small",
                "isSubtle": true,
                "spacing": "None",
                "wrap": true
              }
            ]
          },
          {
            "type": "Container",
            "style": "attention",
            "separator": true,
            "items": [
              {
                "type": "TextBlock",
                "text": "\u26a0\ufe0f Data Privacy & GDPR Awareness (MANDATORY)",
                "weight": "Bolder",
                "color": "Attention"
              },
              {
                "type": "TextBlock",
                "text": "\ud83d\udee1\ufe0f Compliance  \u2022  2 hours  \u2022  Due: Apr 30  \u2022  Required for all staff",
                "size": "Small",
                "isSubtle": true,
                "spacing": "None",
                "wrap": true
              }
            ]
          },
          {
            "type": "Input.ChoiceSet",
            "id": "lms_enroll",
            "label": "Enroll in a course",
            "choices": [
              {
                "title": "Azure Databricks Advanced",
                "value": "databricks_adv"
              },
              {
                "title": "Rust for Production Systems",
                "value": "rust_prod"
              },
              {
                "title": "Leading Remote Teams",
                "value": "remote_leadership"
              },
              {
                "title": "Data Privacy & GDPR (Mandatory)",
                "value": "gdpr_mandatory"
              }
            ]
          },
          {
            "type": "ActionSet",
            "spacing": "Medium",
            "actions": [
              {
                "type": "Action.Submit",
                "title": "\ud83d\udce5 Enroll Now",
                "style": "positive",
                "data": {
                  "action": "enroll_course",
                  "demo_mode": true
                }
              },
              {
                "type": "Action.ToggleVisibility",
                "title": "\u2190 Back",
                "targetElements": [
                  {
                    "elementId": "lmsCatalog",
                    "isVisible": false
                  },
                  {
                    "elementId": "lmsMenu",
                    "isVisible": true
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "Container",
        "id": "lmsPath",
        "isVisible": false,
        "items": [
          {
            "type": "TextBlock",
            "text": "\ud83d\udccb My Learning Path",
            "size": "Large",
            "weight": "Bolder",
            "color": "Accent"
