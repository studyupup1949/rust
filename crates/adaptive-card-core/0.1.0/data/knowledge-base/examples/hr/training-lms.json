{
  "id": "hr/training-lms",
  "title": "Training & Learning Management \u2014 Course Catalog and Progress",
  "description": "Learning management card with course catalog, enrollment status, progress tracking, completion certificates, and upcoming trainings. Uses ImageSet for course thumbnails, progress bars, and FactSet for completion stats.",
  "category": "hr",
  "tags": [
    "hr",
    "training",
    "lms",
    "learning",
    "course",
    "education",
    "enrollment",
    "certificate",
    "progress"
  ],
  "use_cases": [
    "Browse available courses in catalog",
    "Track training progress and completions",
    "Enroll in new courses",
    "View certificates and transcripts"
  ],
  "host_targets": [
    "generic",
    "teams",
    "web_chat"
  ],
  "complexity": "intermediate",
  "card": {
    "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
    "type": "AdaptiveCard",
    "version": "1.5",
    "metadata": {
      "webUrl": "https://greentic.io/cards/training-lms",
      "demo_mode": true
    },
    "body": [
      {
        "type": "Container",
        "id": "lmsMenu",
        "isVisible": true,
        "style": "emphasis",
        "bleed": true,
        "items": [
          {
            "type": "ColumnSet",
            "columns": [
              {
                "type": "Column",
                "width": "auto",
                "items": [
                  {
                    "type": "Image",
                    "url": "https://img.icons8.com/fluency/96/graduation-cap.png",
                    "size": "Medium"
                  }
                ],
                "verticalContentAlignment": "Center"
              },
              {
                "type": "Column",
                "width": "stretch",
                "items": [
                  {
                    "type": "TextBlock",
                    "text": "Learning & Training",
                    "size": "ExtraLarge",
                    "weight": "Bolder",
                    "color": "Accent"
                  },
                  {
                    "type": "TextBlock",
                    "text": "Browse courses, track certifications, and complete compliance training.",
                    "spacing": "None",
                    "isSubtle": true,
                    "wrap": true
                  }
                ]
              }
            ]
          },
          {
            "type": "Container",
            "style": "attention",
            "spacing": "Medium",
            "items": [
              {
                "type": "TextBlock",
                "text": "\u26a0\ufe0f Mandatory Training Due",
                "weight": "Bolder",
                "color": "Attention"
              },
              {
                "type": "TextBlock",
                "text": "\"Data Privacy & GDPR Awareness\" \u2014 Due: April 30, 2026",
                "size": "Small",
                "wrap": true,
                "spacing": "None"
              }
            ]
          },
          {
            "type": "Container",
            "style": "good",
            "spacing": "Small",
            "items": [
              {
                "type": "ColumnSet",
                "columns": [
                  {
                    "type": "Column",
                    "width": "1",
                    "items": [
                      {
                        "type": "TextBlock",
                        "text": "Completed",
                        "size": "Small",
                        "isSubtle": true,
                        "horizontalAlignment": "Center"
                      },
                      {
                        "type": "TextBlock",
                        "text": "12",
                        "weight": "Bolder",
                        "color": "Good",
                        "size": "Large",
                        "horizontalAlignment": "Center",
                        "spacing": "None"
                      }
                    ]
                  },
                  {
                    "type": "Column",
                    "width": "1",
                    "items": [
                      {
                        "type": "TextBlock",
                        "text": "In Progress",
                        "size": "Small",
                        "isSubtle": true,
                        "horizontalAlignment": "Center"
                      },
                      {
                        "type": "TextBlock",
                        "text": "3",
                        "weight": "Bolder",
                        "color": "Accent",
                        "size": "Large",
                        "horizontalAlignment": "Center",
                        "spacing": "None"
                      }
                    ]
                  },
                  {
                    "type": "Column",
                    "width": "1",
                    "items": [
                      {
                        "type": "TextBlock",
                        "text": "Certificates",
                        "size": "Small",
                        "isSubtle": true,
                        "horizontalAlignment": "Center"
                      },
                      {
                        "type": "TextBlock",
                        "text": "5",
                        "weight": "Bolder",
                        "color": "Accent",
                        "size": "Large",
                        "horizontalAlignment": "Center",
                        "spacing": "None"
                      }
                    ]
                  }
                ]
              }
            ]
          },
          {
            "type": "ActionSet",
            "spacing": "Medium",
            "actions": [
              {
                "type": "Action.ToggleVisibility",
                "title": "\ud83d\udcda Course Catalog",
                "style": "positive",
                "targetElements": [
                  {
                    "elementId": "lmsMenu",
                    "isVisible": false
                  },
                  {
                    "elementId": "lmsCatalog",
                    "isVisible": true
                  }
                ]
              },
              {
                "type": "Action.ToggleVisibility",
                "title": "\ud83d\udccb My Learning Path",
                "targetElements": [
                  {
                    "elementId": "lmsMenu",
                    "isVisible": false
                  },
                  {
                    "elementId": "lmsPath",
                    "isVisible": true
                  }
                ]
              },
              {
                "type": "Action.ToggleVisibility",
                "title": "\ud83c\udfc5 Certifications",
                "targetElements": [
                  {
                    "elementId": "lmsMenu",
                    "isVisible": false
                  },
                  {
                    "elementId": "lmsCerts",
                    "isVisible": true
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "Container",
        "id": "lmsCatalog",
        "isVisible": false,
        "items": [
          {
            "type": "TextBlock",
            "text": "\ud83d\udcda Course Catalog",
            "size": "Large",
            "weight": "Bolder",
            "color": "Accent"
          },
          {
            "type": "Input.Text",
            "id": "lms_search",
            "label": "Search courses",
            "placeholder": "e.g. Azure, Python, Leadership..."
          },
          {
            "type": "Input.ChoiceSet",
            "id": "lms_filter",
            "label": "Category",
            "value": "all",
            "choices": [
              {
                "title": "All Categories",
                "value": "all"
              },
              {
                "title": "\u2601\ufe0f Cloud & Infrastructure",
                "value": "cloud"
              },
              {
                "title": "\ud83d\udcca Data & AI",
                "value": "data_ai"
              },
              {
                "title": "\ud83d\udcbb Software Engineering",
                "value": "engineering"
              },
              {
                "title": "\ud83d\udee1\ufe0f Security & Compliance",
                "value": "security"
              },
              {
                "title": "\ud83e\udd1d Soft Skills & Leadership",
                "value": "leadership"
              },
              {
                "title": "\ud83d\udccb Mandatory / Compliance",
                "value": "mandatory"
              }
            ]
          },
          {
            "type": "TextBlock",
            "text": "Recommended For You",
            "weight": "Bolder",
            "spacing": "Medium"
