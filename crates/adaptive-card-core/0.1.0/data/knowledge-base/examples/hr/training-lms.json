            "type": "TextBlock",
            "text": "In Progress",
            "weight": "Bolder",
            "spacing": "Medium"
          },
          {
            "type": "FactSet",
            "facts": [
              {
                "title": "Azure AI Engineer (DP-100)",
                "value": "\u23f3 65% \u2014 Module 6 of 10"
              },
              {
                "title": "Advanced Databricks",
                "value": "\u23f3 30% \u2014 Module 3 of 8"
              },
              {
                "title": "GDPR Awareness",
                "value": "\u2b1c Not started \u2014 Due Apr 30"
