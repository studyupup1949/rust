      {
        "type": "Container",
        "id": "lmsCerts",
        "isVisible": false,
        "items": [
          {
            "type": "TextBlock",
            "text": "\ud83c\udfc5 My Certifications",
            "size": "Large",
            "weight": "Bolder",
            "color": "Accent"
          },
          {
            "type": "FactSet",
            "facts": [
              {
                "title": "Azure Data Engineer DP-203",
                "value": "\u2705 Valid until Mar 2028"
              },
              {
                "title": "Azure AI Fundamentals AI-900",
                "value": "\u2705 Valid until Jun 2027"
              },
              {
                "title": "Databricks Lakehouse Fundamentals",
                "value": "\u2705 No expiry"
              },
              {
                "title": "Agile Certified Practitioner",
                "value": "\u26a0\ufe0f Expires Dec 2026"
              },
              {
                "title": "ISO 27001 Awareness",
