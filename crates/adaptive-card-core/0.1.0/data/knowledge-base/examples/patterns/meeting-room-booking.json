{
  "id": "patterns/meeting-room-booking",
  "title": "Meeting Room Booking with Hero Banner",
  "description": "Hero backgroundImage with text overlay (Column style default for opaque bg), two-column date/time inputs, form fields, multi-select ChoiceSet for facilities.",
  "category": "patterns",
  "tags": [
    "meeting",
    "booking",
    "room",
    "form",
    "hero-banner",
    "calendar",
    "multi-select"
  ],
  "use_cases": [
    "Meeting room reservation",
    "Resource booking",
    "Event space booking",
    "Form with hero image"
  ],
  "host_targets": [
    "generic",
    "teams",
    "web_chat"
  ],
  "complexity": "intermediate",
  "card": {
    "type": "AdaptiveCard",
    "body": [
      {
        "type": "Container",
        "minHeight": "200px",
        "backgroundImage": {
          "url": "https://images.unsplash.com/photo-1610374792793-f016b77ca51a?ixlib=rb-1.2.1&auto=format&fit=crop&w=1548&q=80"
        },
        "bleed": true,
        "verticalContentAlignment": "Bottom",
        "items": [
          {
            "type": "ColumnSet",
            "columns": [
              {
                "type": "Column",
                "width": 33
              },
              {
                "type": "Column",
                "width": 66,
                "items": [
                  {
                    "type": "TextBlock",
                    "text": "Book a meeting room",
                    "wrap": true,
                    "size": "ExtraLarge",
                    "weight": "Bolder"
                  }
                ],
                "style": "default"
              }
            ]
          }
        ]
      },
      {
        "type": "ColumnSet",
        "columns": [
          {
            "type": "Column",
            "width": "stretch",
            "items": [
              {
                "type": "TextBlock",
                "text": "From when",
                "wrap": true,
                "size": "Small"
              },
              {
                "type": "Input.Date",
                "spacing": "Small",
                "id": "from-date"
              },
              {
                "type": "Input.Time",
                "id": "from-time"
              }
            ]
          },
          {
            "type": "Column",
            "width": "stretch",
            "items": [
              {
                "type": "TextBlock",
                "text": "Until when",
                "wrap": true,
                "size": "Small"
              },
              {
                "type": "Input.Date",
                "spacing": "Small",
                "id": "to-date"
              },
              {
                "type": "Input.Time",
                "spacing": "Small",
                "id": "to-time"
              }
            ]
          }
        ]
      },
      {
        "type": "Container",
        "bleed": true,
        "items": [
          {
            "type": "TextBlock",
            "text": "Meeting title",
            "wrap": true,
            "size": "Small"
          },
          {
            "type": "Input.Text",
            "spacing": "Small",
            "id": "meeting-title"
          },
          {
            "type": "Container",
            "items": [
              {
                "type": "TextBlock",
                "text": "Number of attendees",
                "wrap": true,
                "size": "Small"
              },
              {
                "type": "Input.Number",
                "placeholder": "Enter a number (holds up to 12)",
                "spacing": "Small",
                "min": 3,
                "max": 12,
                "id": "attendees-number"
              }
            ]
          }
        ]
      },
      {
        "type": "Container",
        "items": [
          {
            "type": "TextBlock",
            "text": "Select facilities",
            "wrap": true,
            "size": "Small"
          },
          {
            "type": "Input.ChoiceSet",
            "choices": [
              {
                "title": "Coffee and tea",
                "value": "coffee-tea"
              },
              {
                "title": "Cookies",
                "value": "cookies"
              },
              {
                "title": "Lunch",
                "value": "lunch"
              },
              {
                "title": "Overhead projector",
                "value": "projector"
              }
            ],
            "placeholder": "Select one or multiple items",
            "isMultiSelect": true,
            "spacing": "Small",
            "id": "choice-facilities"
          }
        ]
      },
      {
        "type": "ActionSet",
        "actions": [
          {
            "type": "Action.Submit",
            "title": "Reserve meeting room"
          }
        ]
      }
    ],
    "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
    "version": "1.2"
  },
  "notes": ""
}