{
  "id": "productivity/meeting-scheduler",
  "title": "Meeting Scheduler \u2014 Schedule, Find Availability, Book Rooms",
  "description": "Meeting coordination card with new meeting form (title, attendees, date/time, duration, recurrence), availability finder with team member status grid, and meeting room booking with capacity/equipment filters. Uses ToggleVisibility for multi-tab layout, ColumnSet for time slots and room options, FactSet for meeting details.",
  "category": "productivity",
  "tags": [
    "meeting",
    "scheduler",
    "calendar",
    "availability",
    "room-booking",
    "form",
    "toggle-visibility",
    "productivity",
    "teams"
  ],
  "use_cases": [
    "Schedule a new meeting with attendees and room",
    "Find available time slots across team members",
    "Book a meeting room with equipment requirements",
    "Multi-step meeting coordination workflow"
  ],
  "host_targets": [
    "generic",
    "teams",
    "outlook"
  ],
  "complexity": "advanced",
  "card": {
    "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
    "type": "AdaptiveCard",
    "version": "1.5",
    "metadata": {
      "webUrl": "https://greentic.io/cards/meeting-scheduler",
      "demo_mode": true
    },
    "body": [
      {
        "type": "Container",
        "id": "meetingMenu",
        "isVisible": true,
        "style": "emphasis",
        "bleed": true,
        "items": [
          {
            "type": "ColumnSet",
            "columns": [
              {
                "type": "Column",
                "width": "auto",
                "items": [
                  {
                    "type": "Image",
                    "url": "https://img.icons8.com/fluency/96/planner.png",
                    "size": "Medium"
                  }
                ],
                "verticalContentAlignment": "Center"
              },
              {
                "type": "Column",
                "width": "stretch",
                "items": [
                  {
                    "type": "TextBlock",
                    "text": "Meeting Scheduler",
                    "size": "ExtraLarge",
                    "weight": "Bolder",
                    "color": "Accent"
                  },
                  {
                    "type": "TextBlock",
                    "text": "Schedule meetings, check availability, and book meeting rooms.",
                    "spacing": "None",
                    "isSubtle": true,
                    "wrap": true
                  }
                ]
              }
            ]
          },
          {
            "type": "TextBlock",
            "text": "\ud83d\udcc5 Today \u2014 Saturday, April 12, 2026",
            "weight": "Bolder",
            "spacing": "Medium"
          },
          {
            "type": "Container",
            "style": "default",
            "items": [
              {
                "type": "FactSet",
                "facts": [
                  {
                    "title": "09:00 \u2013 09:30",
                    "value": "\u2615 Daily Standup (INSIGNIA Team)"
                  },
                  {
                    "title": "10:00 \u2013 11:00",
                    "value": "\ud83d\udcca MAP FAS Sprint Review"
                  },
                  {
                    "title": "14:00 \u2013 15:00",
                    "value": "\ud83e\udd1d Greentic Sync w/ Maarten"
                  },
                  {
                    "title": "16:00 \u2013 16:30",
                    "value": "\ud83d\udcde Leiman \u2014 AVD Progress Check"
                  }
                ]
              }
            ]
          },
          {
            "type": "ActionSet",
            "spacing": "Medium",
            "actions": [
              {
                "type": "Action.ToggleVisibility",
                "title": "\ud83d\udcc5 New Meeting",
                "style": "positive",
                "targetElements": [
                  {
                    "elementId": "meetingMenu",
                    "isVisible": false
                  },
                  {
                    "elementId": "newMeeting",
                    "isVisible": true
                  }
                ]
              },
              {
                "type": "Action.ToggleVisibility",
                "title": "\ud83d\udd0d Find Availability",
                "targetElements": [
                  {
                    "elementId": "meetingMenu",
                    "isVisible": false
                  },
                  {
                    "elementId": "findAvailability",
                    "isVisible": true
                  }
                ]
              },
              {
                "type": "Action.ToggleVisibility",
                "title": "\ud83c\udfe2 Book a Room",
                "targetElements": [
                  {
                    "elementId": "meetingMenu",
                    "isVisible": false
                  },
                  {
                    "elementId": "bookRoom",
                    "isVisible": true
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "Container",
        "id": "newMeeting",
        "isVisible": false,
        "items": [
          {
            "type": "TextBlock",
            "text": "\ud83d\udcc5 Schedule New Meeting",
            "size": "Large",
            "weight": "Bolder",
            "color": "Accent"
          },
          {
            "type": "Input.Text",
            "id": "meeting_title",
            "label": "Meeting Title",
            "placeholder": "e.g. Sprint Planning, Client Demo, 1:1 with...",
            "isRequired": true,
            "errorMessage": "Give your meeting a title."
          },
          {
            "type": "Input.ChoiceSet",
            "id": "meeting_type",
            "label": "Meeting Type",
            "value": "video",
            "choices": [
              {
                "title": "\ud83d\udcf9 Video Call (Teams / Zoom)",
                "value": "video"
              },
              {
                "title": "\ud83d\udcde Phone / Audio Only",
                "value": "audio"
              },
              {
                "title": "\ud83c\udfe2 In-Person",
                "value": "in_person"
              },
              {
                "title": "\ud83d\udd00 Hybrid (In-Person + Virtual)",
                "value": "hybrid"
              }
            ]
          },
          {
            "type": "ColumnSet",
            "columns": [
              {
                "type": "Column",
                "width": "1",
                "items": [
                  {
                    "type": "Input.Date",
                    "id": "meeting_date",
                    "label": "Date",
                    "isRequired": true
                  }
                ]
              },
              {
                "type": "Column",
                "width": "1",
                "items": [
                  {
                    "type": "Input.Time",
                    "id": "meeting_start",
                    "label": "Start Time",
                    "value": "10:00",
                    "isRequired": true
                  }
                ]
              },
              {
                "type": "Column",
                "width": "1",
                "items": [
                  {
                    "type": "Input.ChoiceSet",
                    "id": "meeting_duration",
                    "label": "Duration",
                    "value": "30",
                    "choices": [
                      {
                        "title": "15 min",
                        "value": "15"
                      },
                      {
                        "title": "30 min",
                        "value": "30"
                      },
                      {
                        "title": "45 min",
                        "value": "45"
                      },
                      {
                        "title": "1 hour",
                        "value": "60"
                      },
                      {
                        "title": "1.5 hours",
                        "value": "90"
                      },
                      {
                        "title": "2 hours",
                        "value": "120"
                      }
                    ]
                  }
                ]
              }
            ]
          },
          {
            "type": "Input.Text",
            "id": "meeting_attendees",
            "label": "Attendees (email addresses, comma separated)",
            "placeholder": "e.g. john@company.com, sarah@company.com",
            "isRequired": true
          },
          {
            "type": "Input.ChoiceSet",
            "id": "meeting_recurrence",
            "label": "Recurrence",
            "value": "none",
            "choices": [
              {
                "title": "One-time",
                "value": "none"
              },
              {
                "title": "Daily",
                "value": "daily"
              },
              {
                "title": "Weekly",
                "value": "weekly"
              },
              {
                "title": "Bi-weekly",
                "value": "biweekly"
              },
              {
                "title": "Monthly",
                "value": "monthly"
              }
            ]
          },
          {
            "type": "Input.Text",
            "id": "meeting_agenda",
            "label": "Agenda / Notes (optional)",
            "placeholder": "Key topics to discuss...",
            "isMultiline": true
          },
          {
            "type": "Input.Toggle",
            "id": "meeting_reminder",
            "title": "Send reminder 15 min before",
            "value": "true"
          },
          {
            "type": "ActionSet",
            "spacing": "Medium",
            "actions": [
              {
                "type": "Action.Submit",
                "title": "\ud83d\udce4 Send Invite",
                "style": "positive",
                "data": {
                  "action": "schedule_meeting",
                  "demo_mode": true
                }
              },
              {
                "type": "Action.ToggleVisibility",
                "title": "\u2190 Back",
                "targetElements": [
                  {
                    "elementId": "newMeeting",
                    "isVisible": false
                  },
                  {
                    "elementId": "meetingMenu",
                    "isVisible": true
                  }
                ]
              }
            ]
          }
        ]
      },
