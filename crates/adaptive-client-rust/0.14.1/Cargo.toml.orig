[package]
name = "adaptive-client-rust"
version = "0.14.1"
edition = "2024"
description = "A client for interacting with the Adaptive platform"
license = "MIT OR Apache-2.0"

[dependencies]
async-stream = { workspace = true }
futures = { workspace = true }
graphql_client = "0.15.0"
reqwest = { workspace = true, features = ["json", "multipart", "stream"] }
reqwest-middleware = { workspace = true, features = ["multipart", "json"] }
serde = { workspace = true }
serde_json = { workspace = true }
url = { version = "2.5", features = ["serde"] }
uuid = { workspace = true, features = ["serde"] }
tokio = { workspace = true }
thiserror = { workspace = true }
backon = { workspace = true }
bytes = { workspace = true }
tracing = { workspace = true }
