[package]
name = "adaptive-timeout"
version = "0.0.1-alpha.4"
edition = "2024"
rust-version = "1.92.0"                              # MSRV
authors = ["Ahmed Farghal <me@asoli.dev>"]
description = "Adaptive timeout computation based on observed latency percentiles"
categories = ["asynchronous", "concurrency", "network-programming"]
repository = "https://github.com/AhmedSoliman/adaptive-timeout"
license = "MIT"
readme = "README.md"

[features]
default = []
schemars = ["dep:schemars"]
serde = ["dep:serde"]
sync = ["dashmap"]

[dependencies]
dashmap = { version = "6.1", features = ["inline"], optional = true }
foldhash = "0.2"
hdrhistogram = { version = "7.5", default-features = false }
schemars = { version = "1", default-features = false, optional = true }
serde = { version = "1", default-features = false, features = ["derive"], optional = true }
tokio = { version = "1", default-features = false, features = ["time"], optional = true }

[dev-dependencies]
criterion = { version = "0.8", features = ["html_reports"] }
serde_json = "1"

[profile.bench]
lto = "thin"
opt-level = 3
codegen-units = 1

[[bench]]
name = "adaptive_timeout"
harness = false
