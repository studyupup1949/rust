[package]
name = "adar"
version = "0.2.0"
edition = "2021"
license = "MIT"
description = "Collection of architectural tools including flags, state machine, enum and tuple operations."
keywords = ["architecture", "design", "flag", "statemachine", "tuple"]
repository = "https://github.com/nandee95/adar/tree/main/adar"
documentation = "https://docs.rs/adar"

[features]
default = ["serde", "std"]
## Enable `std` support
std = []
## Enable `serde` support
serde = ["dep:serde"]

[dependencies]
num-traits = "0.2.19"
adar-macros = { version = "0.2.0" }
serde = { version = "1.0", optional = true }

[dev-dependencies]
once_cell = "1.21.3"
serde_json = { version = "1.0" }
