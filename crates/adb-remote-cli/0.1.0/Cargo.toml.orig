[package]
name = "adb-remote-cli"
version = "0.1.0"
edition = "2024"
description = "Terminal-based Android TV remote over ADB"
license = "MIT"
repository = "https://github.com/goodboyneon/adb-remote-cli"
readme = "README.md"

[dependencies]
clap = { version = "4.6.6", features = ["derive"] }
crossterm = "0.27"

