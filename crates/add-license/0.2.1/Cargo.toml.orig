[package]
name = "add-license"
version = "0.2.1"
edition = "2021"
license = "MIT"
description = "Subcommand for Cargo that creates a file with a user-defined license in the project's directory."
repository = "https://gitlab.com/marquess-projects/add-license"

[[bin]]
name = "cargo-add-license"
path = "src/main.rs"

[dependencies]
toml = "0.8.13"
