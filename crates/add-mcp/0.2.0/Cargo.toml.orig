[package]
name = "add-mcp"
version = "0.2.0"
edition = "2021"
description = "Install MCP servers into AI client configurations"
license = "MIT"
repository = "https://gitlab.com/ricardo.fgusmao/rust-add-mcp"
keywords = ["mcp", "ai", "cli", "configuration"]
categories = ["command-line-utilities", "config"]

[[bin]]
name = "add-mcp"
path = "src/main.rs"
required-features = ["cli"]

[dependencies]
clap = { version = "4", features = ["derive"], optional = true }
serde = { version = "1", features = ["derive"] }
serde_json = "1"
serde_yaml = "0.9"
toml = "0.8"
dirs = "6"
thiserror = "2"
url = "2"

[features]
default = ["cli"]
cli = ["dep:clap"]

[dev-dependencies]
tempfile = "3"
assert_cmd = "2"
predicates = "3"
