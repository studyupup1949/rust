[package]
name = "address"
version = "0.19.0-rc.3"
description = "This library aids in processing network addresses."
readme = "README.md"
repository = "https://github.com/nikdeapen/address"
homepage = "https://github.com/nikdeapen/address"
authors = ["Nik Deapen <nik@deapen.com>"]
edition = "2024"
license = "MIT"
keywords = ["address", "ip", "domain", "socket", "network"]
categories = ["network-programming", "parser-implementations"]

[dependencies]
idna = { version = "1.1", optional = true }
serde = { version = "1.0", optional = true, default-features = false }

[features]
idna = ["dep:idna"]
serde = ["dep:serde"]

[dev-dependencies]
postcard = { version = "1.1", features = ["alloc"] }
serde_json = "1.0"
serde_test = "1.0"

[package.metadata.docs.rs]
all-features = true
rustdoc-args = ["--cfg", "docsrs"]
