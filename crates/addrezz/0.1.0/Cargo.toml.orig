[package]
name = "addrezz"
version.workspace = true
edition.workspace = true
rust-version.workspace = true
repository = "https://github.com/seq-rs/addrezz"
documentation = "https://docs.rs/addrezz/"
description = "Generic, RFC-compliant address parsing with confident defaults"
categories = ["network-programming", "web-programming", "data-structures"]
keywords = ["ip", "network", "whois", "domain", "web"]
license = "MIT OR Apache-2.0"

[workspace]
members = ["addrezz_core", "addrezz_macros"]
resolver = "3"

[workspace.package]
version = "0.1.0"
edition = "2024"
rust-version = "1.85"

[dependencies]
addrezz_core = { path = "addrezz_core", version = "=0.1.0", default-features = false }
addrezz_macros = { path = "addrezz_macros", version = "=0.1.0", optional = true }

[features]
default = ["macros", "redact"]

# Runtime default scheme for scheme-less inputs. Mutually exclusive.
default_http = ["addrezz_core/default_http"]

# Extras
macros = ["dep:addrezz_macros"]
serde = ["addrezz_core/serde"]
url = ["addrezz_core/url"]
http = ["addrezz_core/http"]
reqwest = ["addrezz_core/reqwest", "http"]
idna = ["addrezz_core/idna"]
redact = ["addrezz_core/redact"]
resolve = ["addrezz_core/resolve"]
resolve_async = ["addrezz_core/resolve_async"]
whois = ["addrezz_core/whois"]
psl = ["addrezz_core/psl"]
ipnet = ["addrezz_core/ipnet"]
schemars = ["addrezz_core/schemars"]
sqlx = ["addrezz_core/sqlx"]
arbitrary = ["addrezz_core/arbitrary"]
proptest = ["addrezz_core/proptest"]
__doctests = [
  "macros",
  "serde",
  "url",
  "http",
  "reqwest",
  "idna",
  "redact",
  "resolve",
  "resolve_async",
  "whois",
  "psl",
  "ipnet",
  "schemars",
  "sqlx",
  "arbitrary",
  "proptest",
]

[dev-dependencies]
serde_json = "1"
idna = { version = "1" }
serde = { version = "1", features = ["derive"] }
http = { version = "1" }
reqwest = { version = "0.13", default-features = false }
schemars = { version = "1.2.1" }
sqlx = { version = "0.9", default-features = false, features = ["postgres"] }
arbitrary = { version = "1" }
proptest = { version = "1" }
whoizz = { version = "0.1.0" }
psl = { version = "2" }
ipnet = { version = "2" }
hickory-resolver = { version = "0.26" }
url = "2"

[package.metadata.docs.rs]
features = ["doctests"]
