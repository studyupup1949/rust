[package]
name = "addrezz_core"
version.workspace = true
edition.workspace = true
rust-version.workspace = true
description = "Core types and parser for addrezz"
license = "MIT OR Apache-2.0"

[dependencies]
url = "2"
thiserror = "2"
percent-encoding = "2"
form_urlencoded = "1"

idna = { version = "1", optional = true }
serde = { version = "1", features = ["derive"], optional = true }
http = { version = "1", optional = true }
reqwest = { version = "0.13", default-features = false, optional = true }
schemars = { version = "1.2", optional = true }
sqlx = { version = "0.9", default-features = false, optional = true }
arbitrary = { version = "1", optional = true }
proptest = { version = "1", optional = true }
whoizz = { version = "0.1.0", optional = true }
psl = { version = "2", optional = true }
ipnet = { version = "2", optional = true }
hickory-resolver = { version = "0.26", optional = true }

[features]
default = []

default_http = []

idna = ["dep:idna"]
serde = ["dep:serde"]
http = ["dep:http"]
reqwest = ["dep:reqwest", "http"]
url = []
redact = []
resolve = []
resolve_async = ["dep:hickory-resolver"]
whois = ["dep:whoizz"]
psl = ["dep:psl"]
ipnet = ["dep:ipnet"]
schemars = ["dep:schemars", "serde"]
sqlx = ["dep:sqlx"]
arbitrary = ["dep:arbitrary"]
proptest = ["dep:proptest"]

[dev-dependencies]
serde_json = "1"
idna = { version = "1" }
serde = { version = "1", features = ["derive"] }
http = { version = "1" }
reqwest = { version = "0.13", default-features = false }
schemars = { version = "1.2" }
sqlx = { version = "0.9", default-features = false }
arbitrary = { version = "1" }
proptest = { version = "1" }
whoizz = { version = "0.1.0" }
psl = { version = "2" }
ipnet = { version = "2" }
hickory-resolver = { version = "0.26" }
