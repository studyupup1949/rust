[package]
name = "adequate"
description = """\
A yet another validation library provides a macro inspired by \
Accord.\
"""
version = "0.1.5"
authors = ["Yasha <yasuhiro.asaka@grauwoelfchen.net>"]
edition = "2018"
homepage = "https://codeberg.org/grauwoelfchen/adequate"
readme = "README.md"
keywords = ["validation"]
categories = ["web-programming"]
documentation = "https://docs.rs/crate/adequate"
repository = "https://codeberg.org/grauwoelfchen/adequate"
license = "Apache-2.0"

exclude = [
  ".cache",
  ".cargo-husky",
  ".woodpecker",
  "Dockerfile.builder",
  "Makefile",
  "rust-toolchain",
  ".clippy.toml",
  ".gitignore",
  ".renovaterc.json",
  ".rustfmt.toml",
]

[badges]
maintenance = { status = "experimental" } # at least while 0.1.x

[dependencies]
lazy_static = "^1.5"
serde = { version = "^1.0", features = ["derive"] }
strfmt = "^0.2"

[dev-dependencies.cargo-husky]
version = "1"
default-features = false
features = ["user-hooks"]
