[package]
name = "adhdreading-site-kit"
version = "0.1.0"
edition = "2021"
description = "Small URL helpers for ADHD Reading, a Chrome extension for focused reading."
license = "MIT"
homepage = "https://adhdreading.org"
repository = "https://github.com/bbwdadfg/adhdreading-site-kit"
documentation = "https://docs.rs/adhdreading-site-kit"
readme = "README.md"
keywords = ["adhdreading", "adhd", "reading", "focus"]
categories = ["web-programming"]
include = ["Cargo.toml", "README.md", "LICENSE", "rust/src/lib.rs"]

[lib]
name = "adhdreading_site_kit"
path = "rust/src/lib.rs"
