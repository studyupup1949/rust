[package]
name = "adi"
version = "0.13.0-pre2"
authors = [
	"Jeron Lau <jeron.lau@plopgrizzly.com>",
]
edition = "2018"
license = "MIT / BSL-1.0"
documentation = "https://docs.rs/adi"
homepage = "https://free.plopgrizzly.com/adi"
repository = "https://github.com/plopgrizzly/adi"
readme = "README.md"
description = "Ultra-portable hardware interface for platform-agnostic applications."
keywords = ["graphics", "input", "hardware", "audio", "peripheral"]
categories = ["gui", "game-engines", "hardware-support", "multimedia",
    "rendering::graphics-api"]

[features]
default = ["screen", "speaker", "mic", "hid"]
screen = ["hid", "ami", "afi", "dl_api", "barg"]
speaker = ["dl_api"]
mic = []
hid = []
net = []
drive = []
usb = []
bluetooth = []
cam = []
gps = []
sensor = []
gpio = []
# Vulkan validation layers
checks = []

[dependencies.libc]
version = "0.2"

[dependencies.ami]
version = "0.13"
optional = true

[dependencies.afi]
version = "0.8.0-pre0"
optional = true

[dependencies.dl_api]
version = "0.2"
optional = true

[dependencies.barg]
version = "0.0.3"
optional = true
