[package]
name = "adif_io"
version = "0.5.1"
edition = "2024"
authors = ["Andreas <df1asc@darc.de>"]
description = "Library to read and write ADIF formated files"
license = "CC-BY-SA-4.0"
readme = "README.md"
repository = "https://codeberg.org/dragoncode/adif_io"
documentation = "https://docs.rs/adif_io/"
keywords = ["hamradio", "adif", "file-format"]
categories = ["data-structures"]

[features]
serde_impl = ["serde"]
serde_loose = ["serde"]

[[example]]
name = "benchmark"
path = "examples/benchmark.rs"

[[example]]
name = "adi2json"
path = "examples/adi2json.rs"
required-features = ["serde_impl"]

[[example]]
name = "json2adi"
path = "examples/json2adi.rs"
required-features = ["serde_impl"]

[[example]]
name = "example"
path = "examples/example.rs"

[[example]]
name = "monitor"
path = "examples/monitor.rs"

[dependencies]
linked-hash-map = { version = "0.5", features = ["serde_impl"] }
regex = "1.12"
chrono = { version = "0.4", features = ["serde"] }
serde_json = "1.0"
serde = { version = "1.0", features = ["derive"], optional = true }
maidenhead = "0.2"

[build-dependencies]
serde_json = "1.0"
linked-hash-map = { version = "0.5", features = ["serde_impl"] }

[dev-dependencies]
log = "0.4"
env_logger = "0.11"
clap = { version = "4.6", features = ["derive"] }
serde_json = "1.0"
