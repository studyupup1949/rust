[package]
name = "adifsurgeon"
version = "0.1.0"
edition = "2024"
license = "GPL-3.0-or-later"
description = "A tool for doctoring ADI files"
repository = "https://gitlab.com/harford/adifsurgeon"
keywords = ["hamradio", "amateurradio", "adi"]

[dependencies]
clap = { version = "4.4", features = ["derive"] }
regex = "1.9.1"
chrono = "0.4"
