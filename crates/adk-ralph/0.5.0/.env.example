# =============================================================================
# Ralph Multi-Agent Autonomous Development System - Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# All settings have sensible defaults - only API keys are required.
# =============================================================================

# =============================================================================
# API Keys (Required - set at least one for your chosen provider)
# =============================================================================

# Google Gemini (default provider)
GOOGLE_API_KEY=your-google-api-key

# Anthropic (Claude models)
# ANTHROPIC_API_KEY=your-anthropic-api-key

# OpenAI (GPT models)
# OPENAI_API_KEY=your-openai-api-key

# DeepSeek
# DEEPSEEK_API_KEY=your-deepseek-api-key

# Groq (ultra-fast inference)
# GROQ_API_KEY=your-groq-api-key

# Fireworks AI
# FIREWORKS_API_KEY=your-fireworks-api-key

# Together AI
# TOGETHER_API_KEY=your-together-api-key

# Mistral AI
# MISTRAL_API_KEY=your-mistral-api-key

# Perplexity
# PERPLEXITY_API_KEY=your-perplexity-api-key

# Cerebras
# CEREBRAS_API_KEY=your-cerebras-api-key

# SambaNova
# SAMBANOVA_API_KEY=your-sambanova-api-key

# Azure AI Inference
# AZURE_AI_API_KEY=your-azure-ai-api-key
# AZURE_AI_ENDPOINT=https://your-endpoint.inference.ai.azure.com

# Amazon Bedrock (uses AWS IAM credentials)
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_REGION=us-east-1

# Ollama (no key needed - runs locally via `ollama serve`)

# =============================================================================
# Per-Agent Model Configuration
# =============================================================================
# Ralph uses three specialized agents, each configurable independently.
#
# Supported providers: gemini, openai, anthropic, deepseek, groq, ollama,
#   fireworks, together, mistral, perplexity, cerebras, sambanova,
#   bedrock, azure-ai

# PRD Agent — deep requirements analysis (thinking recommended)
RALPH_PRD_PROVIDER=gemini
RALPH_PRD_MODEL=gemini-3.1-pro-preview
RALPH_PRD_THINKING=false
# RALPH_PRD_MAX_TOKENS=8192
# RALPH_PRD_TEMPERATURE=0.7

# Architect Agent — complex design decisions (thinking recommended)
RALPH_ARCHITECT_PROVIDER=gemini
RALPH_ARCHITECT_MODEL=gemini-3-pro-preview
RALPH_ARCHITECT_THINKING=false
# RALPH_ARCHITECT_MAX_TOKENS=8192
# RALPH_ARCHITECT_TEMPERATURE=0.7

# Ralph Loop Agent — fast implementation iterations
RALPH_LOOP_PROVIDER=gemini
RALPH_LOOP_MODEL=gemini-2.5-flash
RALPH_LOOP_THINKING=false
# RALPH_LOOP_MAX_TOKENS=4096
# RALPH_LOOP_TEMPERATURE=0.7

# =============================================================================
# Execution Settings
# =============================================================================

# Output verbosity: minimal, normal, verbose, debug
RALPH_DEBUG_LEVEL=normal

# Maximum loop iterations (1–1000)
RALPH_MAX_ITERATIONS=50

# Maximum retries per failed task (1–10)
RALPH_MAX_TASK_RETRIES=3

# Completion message
RALPH_COMPLETION_PROMISE=All tasks completed successfully!

# =============================================================================
# File Paths (relative to RALPH_PROJECT_PATH)
# =============================================================================

RALPH_PROJECT_PATH=.
RALPH_PRD_PATH=prd.md
RALPH_DESIGN_PATH=design.md
RALPH_TASKS_PATH=tasks.json
RALPH_PROGRESS_PATH=progress.json

# =============================================================================
# Telemetry (OpenTelemetry)
# =============================================================================

RALPH_TELEMETRY_ENABLED=true
RALPH_SERVICE_NAME=ralph
RALPH_LOG_LEVEL=info
# RALPH_OTLP_ENDPOINT=http://localhost:4317

# =============================================================================
# Example Configurations
# =============================================================================
#
