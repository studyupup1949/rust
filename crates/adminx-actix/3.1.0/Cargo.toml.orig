[package]
name = "adminx-actix"
description = "Actix Web adapter for the adminx admin-panel framework. Translates Actix requests/responses to the neutral adminx-core types and mounts resource routes onto an Actix Scope."
version.workspace = true
edition.workspace = true
rust-version.workspace = true
authors.workspace = true
license.workspace = true
repository.workspace = true
documentation = "https://docs.rs/adminx-actix"
homepage = "https://github.com/srotas-space/adminx"
readme = "README.md"
keywords = ["admin", "actix", "panel", "crud", "web"]
categories = ["web-programming"]

[dependencies]
adminx-core.workspace = true
serde.workspace = true
serde_json.workspace = true
tracing.workspace = true
actix-web = "4"
actix-multipart = "0.7"
futures-util = "0.3"

[dev-dependencies]
adminx-seaorm = { workspace = true }
tokio.workspace = true
async-trait.workspace = true
