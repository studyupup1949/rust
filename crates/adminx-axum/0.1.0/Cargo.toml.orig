[package]
name = "adminx-axum"
description = "Axum web-framework adapter for the adminx admin-panel framework. Translates Axum requests/responses to the neutral adminx-core types and mounts resource routes onto an Axum Router."
version.workspace = true
edition.workspace = true
rust-version.workspace = true
authors.workspace = true
license.workspace = true
repository.workspace = true

[dependencies]
adminx-core.workspace = true
serde.workspace = true
serde_json.workspace = true
tracing.workspace = true
axum = "0.8"

[dev-dependencies]
adminx-seaorm = { path = "../adminx-seaorm" }
async-trait.workspace = true
serde_json.workspace = true
tokio.workspace = true
