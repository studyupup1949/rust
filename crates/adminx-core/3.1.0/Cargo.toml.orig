[package]
name = "adminx-core"
description = "Framework-neutral core for the adminx admin-panel framework: the Resource trait, storage abstraction, registry, and neutral request/response types shared by every web-framework and database adapter."
version.workspace = true
edition.workspace = true
rust-version.workspace = true
authors.workspace = true
license.workspace = true
repository.workspace = true
documentation = "https://docs.rs/adminx-core"
homepage = "https://github.com/srotas-space/adminx"
readme = "README.md"
keywords = ["admin", "panel", "crud", "actix", "axum"]
categories = ["web-programming", "authentication"]

[dependencies]
serde.workspace = true
serde_json.workspace = true
serde_urlencoded.workspace = true
async-trait.workspace = true
once_cell.workspace = true
lazy_static.workspace = true
tracing.workspace = true
tera = "1.19"
jsonwebtoken = "9.3"
bcrypt = "0.17"
# MFA: TOTP (authenticator apps) + QR provisioning + backup-code randomness.
totp-rs = { version = "5.6", default-features = false, features = ["otpauth", "gen_secret"] }
qrcode = { version = "0.14", default-features = false, features = ["svg"] }
rand = "0.8"

[dev-dependencies]
tokio = { workspace = true }
async-trait.workspace = true
