{% extends "layout.html" %}
{% block content %}
  <div class="flex flex-wrap items-center justify-between gap-3 mb-6">
    <h1 class="text-2xl font-bold text-gray-900 dark:text-white">History <span class="text-gray-400 dark:text-gray-500 font-normal">· {{ resource_name }} · {{ item_id | safe }}</span></h1>
    <div class="flex items-center gap-2">
      <a href="{{ mount | safe }}/{{ base_path | safe }}/view/{{ item_id | safe }}" class="inline-flex items-center px-4 py-2 rounded-lg text-sm font-medium border border-gray-300 dark:border-gray-600 text-gray-700 dark:text-gray-200 hover:bg-gray-50 dark:hover:bg-gray-700 transition">Back to record</a>
    </div>
  </div>

  {% if not audit_enabled %}
    <div class="rounded-xl border border-amber-300 dark:border-amber-500/40 bg-amber-50 dark:bg-amber-500/10 px-6 py-4 text-sm text-amber-800 dark:text-amber-200">
      Audit logging is not enabled for this application, so no history is being recorded.
      Add the <code class="font-mono">adminx-audit</code> crate and call <code class="font-mono">audit::init(..)</code> to turn it on.
    </div>
  {% elif versions | length == 0 %}
    <div class="rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 px-6 py-10 text-center text-gray-500 dark:text-gray-400">
      No changes have been recorded for this record yet.
    </div>
  {% else %}
    <ol class="space-y-4">
      {% for v in versions %}
        <li class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl shadow-sm overflow-hidden">
          <div class="flex flex-wrap items-center gap-3 px-6 py-3 border-b border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-900/40">
            {% if v.event == "create" %}
              <span class="px-2 py-0.5 rounded-full text-xs font-semibold bg-emerald-100 text-emerald-800 dark:bg-emerald-500/15 dark:text-emerald-300">Created</span>
            {% elif v.event == "delete" %}
              <span class="px-2 py-0.5 rounded-full text-xs font-semibold bg-rose-100 text-rose-800 dark:bg-rose-500/15 dark:text-rose-300">Deleted</span>
            {% else %}
              <span class="px-2 py-0.5 rounded-full text-xs font-semibold bg-indigo-100 text-indigo-800 dark:bg-indigo-500/15 dark:text-indigo-300">Updated</span>
            {% endif %}
            <span class="text-sm text-gray-700 dark:text-gray-200">{{ v.whodunnit_email }}</span>
            <span class="ml-auto text-xs font-mono text-gray-500 dark:text-gray-400">{{ v.created_at }}</span>
          </div>

          {% if v.fields | length == 0 %}
            <p class="px-6 py-4 text-sm text-gray-500 dark:text-gray-400">No column-level detail was recorded.</p>
          {% else %}
            <table class="min-w-full text-sm">
              <thead>
                <tr class="text-left text-xs uppercase tracking-wide text-gray-500 dark:text-gray-400">
                  <th class="px-6 py-2 font-medium w-1/4">Field</th>
                  <th class="px-6 py-2 font-medium">Before</th>
                  <th class="px-6 py-2 font-medium">After</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-gray-200 dark:divide-gray-700">
                {% for f in v.fields %}
                  <tr>
                    <th class="px-6 py-3 text-left font-medium text-gray-500 dark:text-gray-400 align-top">{{ f.name | replace(from="_", to=" ") | title }}</th>
                    <td class="px-6 py-3 align-top text-rose-700 dark:text-rose-300 break-all">{{ f.old }}</td>
                    <td class="px-6 py-3 align-top text-emerald-700 dark:text-emerald-300 break-all">{{ f.new }}</td>
                  </tr>
                {% endfor %}
              </tbody>
            </table>
          {% endif %}
        </li>
      {% endfor %}
    </ol>

    {% if versions | length >= limit %}
      <p class="mt-4 text-xs text-gray-500 dark:text-gray-400">Showing the most recent {{ limit }} changes. Older entries remain in the audit log.</p>
    {% endif %}
  {% endif %}
{% endblock content %}
