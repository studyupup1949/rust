[package]
name = "adminx-rbac"
description = "Pluggable, DB-backed RBAC authorizer for the adminx admin-panel framework. Gates every resource route by (role, action, resource) read from the database, over SeaORM or MongoDB, editable at runtime from the panel."
version.workspace = true
edition.workspace = true
rust-version.workspace = true
authors.workspace = true
license.workspace = true
repository.workspace = true

[dependencies]
adminx-core.workspace = true
async-trait.workspace = true
serde_json.workspace = true
tracing.workspace = true
once_cell.workspace = true

[dev-dependencies]
tokio = { workspace = true }
async-trait.workspace = true
