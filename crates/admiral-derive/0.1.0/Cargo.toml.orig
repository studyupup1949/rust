[package]
name = "admiral-derive"
version = "0.1.0"
edition = "2018"
description = "Procedural macro for Admiral test runner"
license = "MIT OR Apache-2.0"

[lib]
proc-macro = true

[dependencies]
quote = "1.0.2"
syn = { version = "1.0.3", features = ["full","fold"] }
proc-macro2 = "1.0.1"
rustc-test = "0.3.1"
admiral-types = {path = "../admiral-types", version = "0.1.0"}