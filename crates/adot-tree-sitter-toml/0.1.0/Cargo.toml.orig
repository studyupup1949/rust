[package]
name = "adot-tree-sitter-toml"
description = "Toml grammar for tree-sitter"
version = "0.1.0"
authors = ["Ikatyang"]
license = "MIT"
readme = "README.md"
keywords = ["incremental", "parsing", "tree-sitter", "toml"]
categories = ["parser-implementations", "parsing", "text-editors"]
repository = "https://codeberg.org/adot/tree-sitter-toml"
edition = "2021"
autoexamples = false

build = "bindings/rust/build.rs"
include = [
  "bindings/rust/*",
  "grammar.js",
  "queries/*",
  "src/*",
  "tree-sitter.json",
  "/LICENSE",
]

[lib]
path = "bindings/rust/lib.rs"
name = "tree_sitter_toml"

[dependencies]
tree-sitter-language = "0.1"

[build-dependencies]
cc = "1.2"

[dev-dependencies]
tree-sitter = "0.25.10"
