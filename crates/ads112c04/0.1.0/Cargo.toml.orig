[package]
name = "ads112c04"
version = "0.1.0"
edition = "2024"
authors = ["Åke Amcoff <ake@amcoff.net>"]
license = "MIT OR Apache-2.0"
description = "A no_std embedded-hal 1.0 driver for the TI ADS112C04 16-bit I2C Delta-Sigma ADC"
readme = "README.md"
homepage = "https://github.com/akeamc/ads112c04"
repository = "https://github.com/akeamc/ads112c04"
documentation = "https://docs.rs/ads112c04"
keywords = ["embedded", "adc", "i2c", "sensor", "no-std"]
categories = ["embedded", "hardware-support", "no-std"]

[dependencies]
embedded-hal = "1.0"
bitflags = "2.11"

[dev-dependencies]
embedded-hal-mock = "0.11.1"
