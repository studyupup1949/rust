							<Entry Name="Controlword for axis__Non-generative brake order_n" Index="#x6000" Sub="#x01">
								<Type>BIT</Type>
								<Comment><![CDATA[Order for the axis to brake without generating energy back in the power supply module. Active low]]></Comment>
							</Entry>
							<Entry Name="Controlword for axis__Ready to operate" Index="#x6000" Sub="#x02">
								<Type>BIT</Type>
								<Comment><![CDATA[High if no errors, mains voltage between tolerances, dc link loaded and relays closed. It allows the axis to be enabled. If this gets low in operation, the axis do not be disabled but rather it avoids the axis to be enabled again.]]></Comment>
							</Entry>
							<Entry Name="Controlword for axis__TorqueOFF order_n" Index="#x6000" Sub="#x03">
								<Type>BIT</Type>
								<Comment><![CDATA[Order for the axis to switch off the torque. Active low]]></Comment>
							</Entry>
							<Entry Name="Controlword for axis__Generative brake order_n" Index="#x6000" Sub="#x04">
								<Type>BIT</Type>
								<Comment><![CDATA[Order for the axis to brake without demanding energy from the DcLink. Active low]]></Comment>
							</Entry>
							<Entry Name="Controlword for axis__Limit dc link current_order_n" Index="#x6000" Sub="#x05">
								<Type>BIT</Type>
								<Comment><![CDATA[Order for the axis to limit the requested current from the DC link. Active low. Cause: Motoric load (6001:04) greater than 102%.]]></Comment>
							</Entry>
							<Entry Name="Controlword for axis__NC handling_order_n" Index="#x6000" Sub="#x06">
								<Type>BIT</Type>
								<Comment><![CDATA[Order for the NC to handle. Active low]]></Comment>
							</Entry>
