[package]
name = "adtp2" # Alula's Data Transfer Protocol 2
version = "1.0.2"
edition = "2024"
description = "Alula's Data Transfer Protocol Version 2"
homepage = "https://applepiecodes.github.io/adtp"
license = "MPL-2.0"
readme = "README.md"
repository = "https://github.com/ApplePieCodes/adtp-rs"

[dependencies]
serde = {version = "1.0.219", features = ["derive"]}
serde_json = "1.0.140"