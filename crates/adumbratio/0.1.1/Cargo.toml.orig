[package]
name = "adumbratio"
version = "0.1.1"
authors = ["duskmoon (Campbell He) <kp.campbell.he@duskmoon314.com>"]
edition = "2024"
repository = "https://github.com/duskmoon314/adumbratio"
rust-version = "1.95"
license = "MIT OR Apache-2.0"
description = "Composable building blocks for probabilistic data structures (sketches), with the classical sketches assembled from them"
keywords = [
    "sketch",
    "bloom-filter",
    "streaming",
    "data-structures",
    "probabilistic",
]
categories = ["algorithms", "data-structures", "no-std"]
exclude = [".github/", ".claude/", "DESIGN.md"]

[package.metadata.docs.rs]
all-features = true
rustdoc-args = ["--cfg", "docsrs"]

[dependencies]
libm = { version = "0.2", optional = true }
serde = { version = "1.0.229", default-features = false, features = [
    "derive",
    "alloc",
], optional = true }

[dev-dependencies]
bloomfilter = "3.0.1"
criterion = "0.8.2"
cuckoofilter = "0.5.0"
postcard = { version = "1.1.3", features = ["alloc"] }

[[bench]]
name = "sketch_ops"
harness = false

[[bench]]
name = "comparison"
harness = false

[features]
default = ["std"]
std = ["serde?/std"]
serde = ["dep:serde"]
libm = ["dep:libm"]
