[package]
name = "advance-router"
version = "0.1.0"
edition = "2021"
description = "A unified Rust SDK for multiple LLM providers - like Vercel AI SDK for Rust"
license = "MIT"
repository = "https://github.com/advancinggg/advance-router"

[features]
default = ["openai", "anthropic", "gemini"]
openai = []
deepseek = []
grok = []
minimax = []
glm = []
qwen = []
anthropic = []
gemini = []
all-providers = ["openai", "deepseek", "grok", "minimax", "glm", "qwen", "anthropic", "gemini"]

[dependencies]
tokio = { version = "1", features = ["rt-multi-thread", "macros", "time", "sync"] }
reqwest = { version = "0.12", features = ["json", "stream"] }
reqwest-eventsource = "0.6"
futures = "0.3"
tokio-stream = "0.1"
serde = { version = "1", features = ["derive"] }
serde_json = "1"
async-trait = "0.1"
thiserror = "2"
tracing = "0.1"
base64 = "0.22"
bytes = "1"
pin-project-lite = "0.2"
async-stream = "0.3"

[dev-dependencies]
tokio-test = "0.4"
wiremock = "0.6"
