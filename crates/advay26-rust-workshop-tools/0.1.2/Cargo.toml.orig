[package]
name = "advay26-rust-workshop-tools"
version = "0.1.2"
edition = "2021"
description = "Advay's sample crate for the Rust workshop"
license = "MIT"
documentation = "https://docs.rs/advay26-rust-workshop-tools"

[dependencies]
advay26-rust-workshop-tools-lib = { version = "=0.1.2", path = "./crates/advay26-rust-workshop-tools-lib" }

[workspace]
members = [".", "crates/*"]