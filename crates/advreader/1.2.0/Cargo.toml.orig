[package]
name = "advreader"
version = "1.2.0"                                                                 # remember to update html_root_url
description = "Split text file into text sequences, strings and (line) comments."
authors = ["Martin Bammer <mrbm74@gmail.com>"]
edition = "2021"
license = "MIT"
readme = "README.md"
homepage = "https://gitlab.com/brmmm3/advreader"
repository = "https://gitlab.com/brmmm3/advreader"
keywords = ["reader"]
categories = ["parsing", "text-processing"]

[lib]
name = "advreader"
crate_type = ["rlib", "cdylib"]

[dependencies]
flume = "0.11"

[badges]
travis-ci = { repository = "brmmm3/advreader" }
