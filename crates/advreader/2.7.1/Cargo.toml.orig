[package]
name = "advreader"
version = "2.7.1"
description = "Split text file into text sequences, strings and (line) comments."
authors = ["Martin Bammer <mrbm74@gmail.com>"]
edition = "2024"
license = "MIT"
readme = "README.md"
homepage = "https://gitlab.com/brmmm3/advreader"
repository = "https://gitlab.com/brmmm3/advreader"
keywords = ["reader"]
categories = ["parsing", "text-processing"]

[lib]
name = "advreader"
crate-type = ["lib"]

[dependencies]
flume = "0.12"
encoding_rs = { version = "0.8", features = [
    "simd-accel",
    "fast-legacy-encode",
] }

[dev-dependencies]
criterion = { version = "0.8", features = ["html_reports"] }
threadpool = "1.8"
num_cpus = "1.17"

[[bench]]
name = "big_file"
harness = false

[badges]
travis-ci = { repository = "brmmm3/advreader" }
