[package]
name        = "adxl3xx"
version     = "0.1.0"
edition     = "2024"
description = "ADXL375/ADXL343/ADXL345/ADXL3xx Accelerometer Driver"
readme      = "README.md"
authors     = ["Anna Simmons <anna@simmons.ovh>", "lhndo"]
categories  = ["no-std", "embedded", "hardware-support"]
keywords    = ["adxl375", "adxl343", "adxl345", "adxl3", "accelerometer"]


license    = "MIT"
repository = "https://github.com/LinuxSBC/adxl3xx"


[dependencies]
embedded-hal = "1.0.0"

[lints.rust]
dead_code        = "allow"
unused_variables = "allow"


[lints.clippy]
needless_return       = "allow"
new_without_default   = "allow"
comparison_chain      = "allow"
manual_range_contains = "allow"
needless_range_loop   = "allow"
unused_self           = "allow"
